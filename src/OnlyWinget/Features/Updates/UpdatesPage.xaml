<UserControl
    x:Class="OnlyWinget.Features.Updates.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OnlyWinget.Controls"
    xmlns:states="using:OnlyWinget.DesignSystem.States"
    xmlns:commands="using:OnlyWinget.DesignSystem.Commands"
    xmlns:presentation="using:OnlyWinget.Presentation"
    xmlns:appPresentation="using:OnlyWinget.Application.Presentation">
    <Grid RowSpacing="12" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}">
            <commands:OnlyWingetCommandBar ItemsSource="{x:Bind ViewModel.Commands.Values, Mode=OneWay}" CommandInvoked="OnCommandInvoked" VerticalAlignment="Center" />
        </Border>
        <states:StatePresenter x:Name="PageState" Grid.Row="1" />
        <Border Grid.Row="2" Style="{StaticResource ListCardStyle}">
            <controls:OnlyWingetTable x:Name="UpdateList" ItemsSource="{x:Bind ViewModel.Updates}" HeaderSelection="{x:Bind presentation:PresentationValues.HeaderSelection(ViewModel.HeaderState), Mode=OneWay}" AutomationProperties.AutomationId="UpdateList" ToggleAllRequested="OnToggleAllUpdates" SelectionToggled="OnUpdateSelectionToggled">
                <controls:OnlyWingetTableColumn Header="Name" BindingPath="Name" Width="210" IsPrimary="True" />
                <controls:OnlyWingetTableColumn Header="Package ID" BindingPath="PackageId" Width="250" IsTextSelectable="True" />
                <controls:OnlyWingetTableColumn Header="Source" BindingPath="Source" Width="100" />
                <controls:OnlyWingetTableColumn Header="Installed" BindingPath="InstalledVersion" Width="110" />
                <controls:OnlyWingetTableColumn Header="Available" BindingPath="AvailableVersion" Width="120" />
                <controls:OnlyWingetTableColumn Header="Architecture" BindingPath="Architecture" Width="130" />
                <controls:OnlyWingetTableColumn Header="Status" BindingPath="Status" Width="*" />
            </controls:OnlyWingetTable>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource ListCardStyle}" Visibility="{x:Bind presentation:PresentationValues.Visibility(ViewModel.HasOperationResults), Mode=OneWay}">
            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="OperationResultList" ItemsSource="{x:Bind ViewModel.OperationResults}" AutomationProperties.AutomationId="UpdatesOperationResults" Padding="12,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="appPresentation:OperationResultRow">
                            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="180" />
                                        <ColumnDefinition Width="Auto" MinWidth="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind PackageId, Mode=OneTime}" Style="{StaticResource RowPrimaryTextBlockStyle}" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Status, Mode=OneTime}" Style="{StaticResource RowSecondaryTextBlockStyle}" Foreground="{x:Bind presentation:PresentationValues.StatusBrush(Succeeded), Mode=OneTime}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ErrorDetails, Mode=OneTime}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource RowSecondaryTextBlockStyle}" VerticalAlignment="Center" Visibility="{x:Bind presentation:PresentationValues.HasErrorDetails(ErrorDetails), Mode=OneTime}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
