<UserControl x:Class="OnlyWinget.Features.Updates.UpdatesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:OnlyWinget.Controls" xmlns:states="using:OnlyWinget.DesignSystem.States" xmlns:commands="using:OnlyWinget.DesignSystem.Commands">
    <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8"><ProgressRing x:Name="LoadingRing" Width="24" Height="24"/><commands:OnlyWingetCommandBar x:Name="CommandBar" CommandInvoked="OnCommandInvoked"/></StackPanel>
        <controls:OnlyWingetTable x:Name="UpdateList" Grid.Row="1" AutomationProperties.AutomationId="UpdateList" ToggleAllRequested="OnToggleAllUpdates" SelectionToggled="OnUpdateSelectionToggled">
            <controls:OnlyWingetTableColumn Header="Name" BindingPath="Name" Width="210" IsPrimary="True"/><controls:OnlyWingetTableColumn Header="Package ID" BindingPath="PackageId" Width="250" IsTextSelectable="True"/><controls:OnlyWingetTableColumn Header="Source" BindingPath="Source" Width="100"/><controls:OnlyWingetTableColumn Header="Installed" BindingPath="InstalledVersion" Width="110"/><controls:OnlyWingetTableColumn Header="Available" BindingPath="AvailableVersion" Width="120"/><controls:OnlyWingetTableColumn Header="Architecture" BindingPath="Architecture" Width="130"/><controls:OnlyWingetTableColumn Header="Status" BindingPath="Status" Width="150"/>
        </controls:OnlyWingetTable>
        <states:OperationBanner x:Name="OperationStatus" Grid.Row="2" CancelRequested="OnOperationCancelRequested"/>
        <ItemsControl x:Name="OperationResultList" Grid.Row="3" AutomationProperties.AutomationId="UpdatesOperationResults"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Padding="8" Spacing="2"><TextBlock Text="{Binding PackageId}" Style="{StaticResource RowPrimaryTextBlockStyle}" IsTextSelectionEnabled="True"/><TextBlock Text="{Binding Status}"/><TextBlock Text="{Binding ErrorDetails}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <states:StatePresenter x:Name="PageState" Grid.Row="4"/>
    </Grid>
</UserControl>
