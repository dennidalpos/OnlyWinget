<UserControl x:Class="OnlyWinget.Features.Updates.UpdatesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:OnlyWinget.Controls" xmlns:states="using:OnlyWinget.DesignSystem.States" xmlns:commands="using:OnlyWinget.DesignSystem.Commands" xmlns:presentation="using:OnlyWinget.Presentation">
    <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}">
            <commands:OnlyWingetCommandBar ItemsSource="{x:Bind ViewModel.Commands.Values, Mode=OneWay}" CommandInvoked="OnCommandInvoked" VerticalAlignment="Center"/>
        </Border>
        <states:StatePresenter x:Name="PageState" Grid.Row="1"/>
        <Border Grid.Row="2" Style="{StaticResource ListCardStyle}">
            <controls:OnlyWingetTable x:Name="UpdateList" ItemsSource="{x:Bind ViewModel.Updates}" HeaderSelection="{x:Bind presentation:PresentationValues.HeaderSelection(ViewModel.HeaderState), Mode=OneWay}" AutomationProperties.AutomationId="UpdateList" ToggleAllRequested="OnToggleAllUpdates" SelectionToggled="OnUpdateSelectionToggled">
                <controls:OnlyWingetTableColumn Header="Name" BindingPath="Name" Width="210" IsPrimary="True"/><controls:OnlyWingetTableColumn Header="Package ID" BindingPath="PackageId" Width="250" IsTextSelectable="True"/><controls:OnlyWingetTableColumn Header="Source" BindingPath="Source" Width="100"/><controls:OnlyWingetTableColumn Header="Installed" BindingPath="InstalledVersion" Width="110"/><controls:OnlyWingetTableColumn Header="Available" BindingPath="AvailableVersion" Width="120"/><controls:OnlyWingetTableColumn Header="Architecture" BindingPath="Architecture" Width="130"/><controls:OnlyWingetTableColumn Header="Status" BindingPath="Status" Width="*"/>
            </controls:OnlyWingetTable>
        </Border>
        <states:OperationBanner x:Name="OperationStatus" Grid.Row="3" CancelRequested="OnOperationCancelRequested"/>
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Visibility="{x:Bind presentation:PresentationValues.Visibility(ViewModel.HasOperationResults), Mode=OneWay}">
            <ItemsControl x:Name="OperationResultList" ItemsSource="{x:Bind ViewModel.OperationResults}" AutomationProperties.AutomationId="UpdatesOperationResults">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding PackageId}" Style="{StaticResource RowPrimaryTextBlockStyle}" IsTextSelectionEnabled="True"/>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource RowSecondaryTextBlockStyle}"/>
                                <TextBlock Text="{Binding ErrorDetails}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource RowSecondaryTextBlockStyle}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>
