<UserControl
    x:Class="OnlyWinget.Features.Updates.WindowsUpdateHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OnlyWinget.Controls"
    xmlns:states="using:OnlyWinget.DesignSystem.States"
    xmlns:commands="using:OnlyWinget.DesignSystem.Commands"
    xmlns:presentation="using:OnlyWinget.Presentation"
    xmlns:design="using:OnlyWinget.DesignSystem.Controls"
    xmlns:services="using:OnlyWinget.Services">
    <Grid RowSpacing="12" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}">
            <design:OnlyWingetResponsivePanel ItemMinWidth="220" HorizontalSpacing="16" VerticalSpacing="12">
                <design:OnlyWingetWrapPanel HorizontalSpacing="16" VerticalSpacing="8" VerticalAlignment="Center">
                    <ComboBox x:Name="GroupFilter" SelectedIndex="0" SelectionChanged="OnGroupFilterChanged" MinWidth="180" AutomationProperties.AutomationId="WindowsHistoryGroupFilter" AutomationProperties.Name="{services:Localize Key=Header_Classification}">
                        <ComboBoxItem Content="{services:Localize Key=History_Filter_All}" Tag="all" />
                        <ComboBoxItem Content="{services:Localize Key=WindowsUpdate_Class_Quality}" Tag="Quality" />
                        <ComboBoxItem Content="{services:Localize Key=WindowsUpdate_Class_Driver}" Tag="Driver" />
                        <ComboBoxItem Content="{services:Localize Key=WindowsUpdate_Class_Feature}" Tag="Feature" />
                        <ComboBoxItem Content="{services:Localize Key=WindowsUpdate_Class_Definition}" Tag="Definition" />
                        <ComboBoxItem Content="{services:Localize Key=WindowsUpdate_Class_Other}" Tag="Other" />
                    </ComboBox>
                    <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                </design:OnlyWingetWrapPanel>
                <commands:OnlyWingetCommandBar ItemsSource="{x:Bind ViewModel.Commands.Values, Mode=OneWay}" CommandInvoked="OnCommandInvoked" VerticalAlignment="Center" />
            </design:OnlyWingetResponsivePanel>
        </Border>
        <states:StatePresenter x:Name="PageState" Grid.Row="1" />
        <Border Grid.Row="2" Style="{StaticResource ListCardStyle}">
            <controls:OnlyWingetTable x:Name="HistoryList" SelectableBindingPath="CanSelect" ItemsSource="{x:Bind ViewModel.Rows}" HeaderSelection="{x:Bind presentation:PresentationValues.HeaderSelection(ViewModel.HeaderState), Mode=OneWay}" SelectionLabel="{services:Localize Key=Command_Select_All}" AutomationProperties.AutomationId="WindowsUpdateHistoryList" ToggleAllRequested="OnToggleAll" BatchSelectionChanged="OnBatchSelectionChanged">
                <controls:OnlyWingetTableColumn Header="{services:Localize Key=Header_Date}" BindingPath="Date" Width="140" />
                <controls:OnlyWingetTableColumn Header="{services:Localize Key=Header_Title}" BindingPath="Title" Width="380" IsPrimary="True" />
                <controls:OnlyWingetTableColumn Header="{services:Localize Key=Header_Classification}" BindingPath="Classification" Width="110" />
                <controls:OnlyWingetTableColumn Header="{services:Localize Key=Header_KnowledgeBase}" BindingPath="KnowledgeBase" Width="110" IsTextSelectable="True" />
                <controls:OnlyWingetTableColumn Header="{services:Localize Key=Header_Result}" BindingPath="Result" Width="150" />
                <controls:OnlyWingetTableColumn Header="{services:Localize Key=Header_Error}" BindingPath="Error" Width="*" IsTextSelectable="True" />
            </controls:OnlyWingetTable>
        </Border>
    </Grid>
</UserControl>
