<UserControl x:Class="OnlyWinget.Features.Updates.WindowsUpdatePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:OnlyWinget.Controls" xmlns:states="using:OnlyWinget.DesignSystem.States" xmlns:commands="using:OnlyWinget.DesignSystem.Commands" xmlns:presentation="using:OnlyWinget.Presentation">
    <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <CheckBox x:Name="SoftwareUpdatesBox" IsChecked="True" AutomationProperties.AutomationId="WindowsSoftwareFilter"/>
                    <CheckBox x:Name="DriverUpdatesBox" IsChecked="True" AutomationProperties.AutomationId="WindowsDriverFilter"/>
                    <CheckBox x:Name="MicrosoftUpdatesBox" IsChecked="True" AutomationProperties.AutomationId="WindowsMicrosoftFilter"/>
                </StackPanel>
                <commands:OnlyWingetCommandBar Grid.Column="1" ItemsSource="{x:Bind ViewModel.Commands.Values, Mode=OneWay}" CommandInvoked="OnCommandInvoked" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <states:StatePresenter x:Name="PageState" Grid.Row="1"/>
        <Border Grid.Row="2" Style="{StaticResource ListCardStyle}">
            <controls:OnlyWingetTable x:Name="WindowsUpdateList" ItemsSource="{x:Bind ViewModel.Updates}" HeaderSelection="{x:Bind presentation:PresentationValues.HeaderSelection(ViewModel.HeaderState), Mode=OneWay}" AutomationProperties.AutomationId="WindowsUpdateList" ToggleAllRequested="OnToggleAllWindowsUpdates" SelectionToggled="OnWindowsUpdateSelectionToggled">
                <controls:OnlyWingetTableColumn Header="Title" BindingPath="Title" Width="320" IsPrimary="True"/><controls:OnlyWingetTableColumn Header="KB" BindingPath="KnowledgeBaseArticles" Width="120" IsTextSelectable="True"/><controls:OnlyWingetTableColumn Header="Severity" BindingPath="Severity" Width="120"/><controls:OnlyWingetTableColumn Header="Categories" BindingPath="Categories" Width="200"/><controls:OnlyWingetTableColumn Header="Size" BindingPath="MaxDownloadSize" Width="110"/><controls:OnlyWingetTableColumn Header="Downloaded" BindingPath="IsDownloaded" Width="110"/><controls:OnlyWingetTableColumn Header="Reboot" BindingPath="RebootRequired" Width="100"/><controls:OnlyWingetTableColumn Header="Revision" BindingPath="Revision" Width="90"/><controls:OnlyWingetTableColumn Header="Status" BindingPath="Status" Width="*"/>
            </controls:OnlyWingetTable>
        </Border>
    </Grid>
</UserControl>
