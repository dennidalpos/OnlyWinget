<Page
    x:Class="OnlyWinget.Features.Updates.UpdatesHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:design="using:OnlyWinget.DesignSystem.Controls"
    xmlns:updates="using:OnlyWinget.Features.Updates">
    <design:PageScaffold x:Name="Scaffold">
        <design:PageScaffold.Commands>
            <SelectorBar x:Name="ModeSelector" SelectionChanged="OnModeChanged" AutomationProperties.AutomationId="UpdatesModes">
                <SelectorBarItem x:Name="WingetMode" Icon="Sync" AutomationProperties.AutomationId="UpdatesWingetTab" />
                <SelectorBarItem x:Name="WindowsMode" Icon="Download" AutomationProperties.AutomationId="UpdatesWindowsTab" />
            </SelectorBar>
        </design:PageScaffold.Commands>
        <design:PageScaffold.Body>
            <Grid>
                <updates:UpdatesPage x:Name="WingetWorkflow" />
                <updates:WindowsUpdatePage x:Name="WindowsWorkflow" Visibility="Collapsed" />
            </Grid>
        </design:PageScaffold.Body>
    </design:PageScaffold>
</Page>
