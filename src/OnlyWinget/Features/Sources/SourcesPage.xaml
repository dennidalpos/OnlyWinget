<Page
    x:Class="OnlyWinget.Features.Sources.SourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:design="using:OnlyWinget.DesignSystem.Controls"
    xmlns:presentation="using:OnlyWinget.Application.Presentation"
    xmlns:states="using:OnlyWinget.DesignSystem.States"
    xmlns:commands="using:OnlyWinget.DesignSystem.Commands">
    <design:PageScaffold x:Name="Scaffold">
        <design:PageScaffold.Commands>
            <commands:OnlyWingetCommandBar x:Name="CommandBar" CommandInvoked="OnCommandInvoked" />
        </design:PageScaffold.Commands>
        <design:PageScaffold.State>
            <states:StatePresenter x:Name="PageState" />
        </design:PageScaffold.State>
        <design:PageScaffold.Body>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid RowSpacing="{StaticResource PageSectionSpacing}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardStyle}">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock x:Name="AddSourceSectionText" Style="{StaticResource SectionTitleTextBlockStyle}" />
                            <StackPanel Grid.Row="1" Spacing="{StaticResource ControlSpacing}">
                                <TextBox x:Name="SourceNameBox" Style="{StaticResource FormTextBoxStyle}" AutomationProperties.AutomationId="SourceNameTextBox" />
                                <TextBox x:Name="SourceArgumentBox" Style="{StaticResource FormTextBoxStyle}" AutomationProperties.AutomationId="SourceArgumentTextBox" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock x:Name="ManageSourcesSectionText" Style="{StaticResource SectionTitleTextBlockStyle}" />
                            <StackPanel x:Name="SourceActions" Grid.Row="1" Style="{StaticResource ActionBarStyle}">
                                <ProgressRing x:Name="LoadingRing" Width="24" Height="24" AutomationProperties.AutomationId="SourcesLoadingRing" AutomationProperties.Name="Loading sources" />
                            </StackPanel>
                            <ListView x:Name="SourceList" Grid.Row="2" MinHeight="240" SelectionMode="Single" ItemContainerStyle="{StaticResource ListRowContainerStyle}" AutomationProperties.AutomationId="SourceList">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="presentation:SourceRow">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{x:Bind Name, Mode=OneTime}" Style="{StaticResource RowPrimaryTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind Argument, Mode=OneTime}" Style="{StaticResource RowSecondaryTextBlockStyle}" IsTextSelectionEnabled="True" />
                                                <TextBlock Text="{x:Bind Type, Mode=OneTime}" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind Status, Mode=OneTime}" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" AutomationProperties.AutomationId="SourceEnabledToggle" AutomationProperties.Name="{x:Bind Name, Mode=OneTime}" IsOn="{x:Bind IsEnabled, Mode=OneTime}" Toggled="OnSourceEnabledToggled" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </design:PageScaffold.Body>
    </design:PageScaffold>
</Page>
