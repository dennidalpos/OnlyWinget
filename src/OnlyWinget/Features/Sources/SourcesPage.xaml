<Page
    x:Class="OnlyWinget.Features.Sources.SourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:design="using:OnlyWinget.DesignSystem.Controls"
    xmlns:presentation="using:OnlyWinget.Application.Presentation"
    xmlns:states="using:OnlyWinget.DesignSystem.States"
    xmlns:commands="using:OnlyWinget.DesignSystem.Commands">
    <Grid>
        <design:PageScaffold x:Name="Scaffold" AreaAccentBrush="{ThemeResource AreaSourcesBrush}">
            <design:PageScaffold.Commands>
                <commands:OnlyWingetCommandBar x:Name="CommandBar" CommandInvoked="OnCommandInvoked" />
            </design:PageScaffold.Commands>
            <design:PageScaffold.State>
                <states:StatePresenter x:Name="PageState" />
            </design:PageScaffold.State>
            <design:PageScaffold.Body>
                <Grid RowSpacing="{StaticResource PageSectionSpacing}" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="AddSourceSectionText" Style="{StaticResource SectionTitleTextBlockStyle}" />
                                <design:OnlyWingetResponsivePanel Grid.Row="1" ItemMinWidth="300" HorizontalSpacing="16" VerticalSpacing="12">
                                    <TextBox x:Name="SourceNameBox" Style="{StaticResource FormTextBoxStyle}" AutomationProperties.AutomationId="SourceNameTextBox" Text="{x:Bind ViewModel.Name.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"/>
                                    <TextBox x:Name="SourceArgumentBox" Style="{StaticResource FormTextBoxStyle}" AutomationProperties.AutomationId="SourceArgumentTextBox" Text="{x:Bind ViewModel.Argument.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"/>
                                </design:OnlyWingetResponsivePanel>
                                <StackPanel x:Name="AddSourceBtnRow" Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="AddSourceBtn" Click="OnAddSourceClick" Style="{StaticResource AddPrimaryButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <design:OnlyWingetWrapPanel Grid.Row="0" HorizontalSpacing="12" VerticalSpacing="8" VerticalAlignment="Center">
                                    <TextBlock x:Name="ManageSourcesSectionText" Style="{StaticResource SectionTitleTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button x:Name="RefreshSourcesBtn" Click="OnRefreshSourcesClick" Padding="8,6" VerticalAlignment="Center">
                                        <SymbolIcon Symbol="Refresh" />
                                    </Button>
                                    <Button x:Name="UpdateSourcesBtn" Click="OnUpdateSourcesClick" Padding="8,6" VerticalAlignment="Center">
                                        <SymbolIcon Symbol="Sync" />
                                    </Button>
                                    <Button x:Name="RemoveSourceBtn" Click="OnRemoveSourceClick" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Padding="8,6" VerticalAlignment="Center">
                                        <SymbolIcon Symbol="Delete" />
                                    </Button>
                                    <Button x:Name="ResetSourcesBtn" Click="OnResetSourcesClick" Padding="8,6" VerticalAlignment="Center">
                                        <SymbolIcon Symbol="Undo" />
                                    </Button>
                                    <ProgressRing x:Name="LoadingRing" Width="20" Height="20" AutomationProperties.AutomationId="SourcesLoadingRing" AutomationProperties.Name="Loading sources" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </design:OnlyWingetWrapPanel>
                                <Grid Grid.Row="1" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SourceNameFilterBox" TextChanged="OnSourceFilterChanged" />
                                    <TextBox x:Name="SourceArgumentFilterBox" Grid.Column="1" TextChanged="OnSourceFilterChanged" />
                                    <TextBox x:Name="SourceTypeFilterBox" Grid.Column="2" TextChanged="OnSourceFilterChanged" />
                                    <TextBox x:Name="SourceStatusFilterBox" Grid.Column="3" TextChanged="OnSourceFilterChanged" />
                                </Grid>
                                <ListView x:Name="SourceList" Grid.Row="2" MinHeight="240" SelectionMode="Single" SelectionChanged="OnSourceSelectionChanged" AutomationProperties.AutomationId="SourceList">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem" BasedOn="{StaticResource ListRowContainerStyle}">
                                            <Setter Property="Padding" Value="0,8" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="presentation:SourceRow">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3" AutomationProperties.Name="{x:Bind Name, Mode=OneTime}">
                                                    <TextBlock Text="{x:Bind Name, Mode=OneTime}" Style="{StaticResource RowPrimaryTextBlockStyle}" />
                                                    <TextBlock Text="{x:Bind Argument, Mode=OneTime}" Style="{StaticResource RowSecondaryTextBlockStyle}" IsTextSelectionEnabled="True" />
                                                    <TextBlock Text="{x:Bind Type, Mode=OneTime}" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                    <ToggleSwitch AutomationProperties.AutomationId="SourceEnabledToggle" AutomationProperties.Name="{x:Bind Name, Mode=OneTime}" IsOn="{x:Bind IsEnabled, Mode=OneWay}" Toggled="OnSourceEnabledToggled" />
                                                    <TextBlock Text="{x:Bind Status, Mode=OneTime}" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
            </design:PageScaffold.Body>
        </design:PageScaffold>
    </Grid>
</Page>
