<UserControl x:Class="OnlyWinget.Features.Packages.PresetsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:OnlyWinget.Controls" xmlns:states="using:OnlyWinget.DesignSystem.States" xmlns:commands="using:OnlyWinget.DesignSystem.Commands" xmlns:presentation="using:OnlyWinget.Presentation" xmlns:appPresentation="using:OnlyWinget.Application.Presentation" xmlns:design="using:OnlyWinget.DesignSystem.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid RowSpacing="12" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource CardStyle}">
                <design:OnlyWingetResponsivePanel ItemMinWidth="360" HorizontalSpacing="16" VerticalSpacing="12">
                    <design:OnlyWingetWrapPanel HorizontalSpacing="8" VerticalSpacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="PresetManagementText" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="PresetSelector" SelectionChanged="OnPresetChanged" AutomationProperties.AutomationId="PresetSelector" Style="{StaticResource FormComboBoxStyle}" Width="160" VerticalAlignment="Center"/>
                        
                        <!-- Add Preset Compact Icon Button -->
                        <Button x:Name="AddPresetBtn" AutomationProperties.AutomationId="AddPresetBtn" VerticalAlignment="Center" Padding="8,6">
                            <SymbolIcon Symbol="Add" />
                            <Button.Flyout>
                                <Flyout x:Name="AddPresetFlyout">
                                    <StackPanel Spacing="8" Width="240">
                                        <TextBox x:Name="PresetNameBox" AutomationProperties.AutomationId="PresetNameTextBox" Style="{StaticResource FormTextBoxStyle}" Text="{x:Bind ViewModel.PresetName.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"/>
                                        <Button x:Name="SavePresetBtn" AutomationProperties.AutomationId="SavePresetBtn" Click="OnAddPresetClick" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        
                        <!-- Rename Preset Compact Icon Button -->
                        <Button x:Name="RenamePresetBtn" AutomationProperties.AutomationId="RenamePresetBtn" VerticalAlignment="Center" Padding="8,6">
                            <SymbolIcon Symbol="Edit" />
                            <Button.Flyout>
                                <Flyout x:Name="RenamePresetFlyout">
                                    <StackPanel Spacing="8" Width="240">
                                        <TextBox x:Name="RenamePresetNameBox" AutomationProperties.AutomationId="RenamePresetNameTextBox" Style="{StaticResource FormTextBoxStyle}" Text="{x:Bind ViewModel.PresetName.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"/>
                                        <Button x:Name="SaveRenamePresetBtn" AutomationProperties.AutomationId="SaveRenamePresetBtn" Click="OnRenamePresetClick" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Delete Preset Compact Icon Button -->
                        <Button x:Name="RemovePresetBtn" Click="OnRemovePresetClick" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.AutomationId="RemovePresetBtn" VerticalAlignment="Center" Padding="8,6">
                            <SymbolIcon Symbol="Delete" />
                        </Button>

                        <!-- Import/Export Compact Icon Buttons -->
                        <Button x:Name="ImportPresetBtn" Click="OnImportPresetClick" AutomationProperties.AutomationId="ImportPresetBtn" VerticalAlignment="Center" Padding="8,6">
                            <SymbolIcon Symbol="Import" />
                        </Button>
                        <Button x:Name="ExportPresetBtn" Click="OnExportPresetClick" AutomationProperties.AutomationId="ExportPresetBtn" VerticalAlignment="Center" Padding="8,6">
                            <SymbolIcon Symbol="Share" />
                        </Button>
                    </design:OnlyWingetWrapPanel>
                    
                    <commands:OnlyWingetCommandBar x:Name="CommandBar" CommandInvoked="OnCommandInvoked" VerticalAlignment="Center" />
                </design:OnlyWingetResponsivePanel>
            </Border>
            
            <!-- Packages Section Header and Row Actions -->
            <design:OnlyWingetWrapPanel Grid.Row="1" HorizontalSpacing="12" VerticalSpacing="8" Margin="0,8,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="PackagesSectionText" Style="{StaticResource SectionTitleTextBlockStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="PackageManagementText" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Collapsed" />
                
                <!-- Add Package Button + Flyout -->
                <Button x:Name="AddPackageBtn" Style="{StaticResource AddPrimaryButtonStyle}" AutomationProperties.AutomationId="AddPackageBtn" VerticalAlignment="Center">
                    <Button.Flyout>
                        <Flyout x:Name="AddPackageFlyout">
                            <StackPanel Spacing="8" Width="240">
                                <TextBox x:Name="PackageIdBox" AutomationProperties.AutomationId="PresetPackageIdTextBox" Style="{StaticResource FormTextBoxStyle}" Text="{x:Bind ViewModel.PackageId.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"/>
                                <TextBox x:Name="PackageSourceBox" AutomationProperties.AutomationId="PresetPackageSourceTextBox" Style="{StaticResource FormTextBoxStyle}" HorizontalAlignment="Stretch"/>
                                <Button x:Name="SavePackageBtn" AutomationProperties.AutomationId="SavePackageBtn" Click="OnAddPackageClick" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Edit Package Button + Flyout -->
                <Button x:Name="EditPackageBtn" Style="{StaticResource EditButtonStyle}" AutomationProperties.AutomationId="EditPackageBtn" VerticalAlignment="Center">
                    <Button.Flyout>
                        <Flyout x:Name="EditPackageFlyout" Opened="OnEditPackageFlyoutOpened">
                            <StackPanel Spacing="8" Width="240">
                                <TextBox x:Name="EditPackageIdBox" Style="{StaticResource FormTextBoxStyle}" Text="{x:Bind ViewModel.PackageId.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"/>
                                <TextBox x:Name="EditPackageSourceBox" Style="{StaticResource FormTextBoxStyle}" HorizontalAlignment="Stretch"/>
                                <Button x:Name="SaveEditPackageBtn" AutomationProperties.AutomationId="SaveEditPackageBtn" Click="OnEditPackageClick" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Remove Package -->
                <Button x:Name="RemovePackageBtn" Click="OnRemovePackageClick" Style="{StaticResource DeleteButtonStyle}" AutomationProperties.AutomationId="RemovePackageBtn" VerticalAlignment="Center"/>
            </design:OnlyWingetWrapPanel>
            <states:StatePresenter x:Name="PageState" Grid.Row="2"/>
            <Border Grid.Row="3" Style="{StaticResource ListCardStyle}" MinHeight="300">
                <controls:OnlyWingetTable x:Name="PackageList" ItemsSource="{x:Bind ViewModel.Packages}" HeaderSelection="{x:Bind presentation:PresentationValues.HeaderSelection(ViewModel.HeaderState), Mode=OneWay}" AutomationProperties.AutomationId="PresetPackageList" ToggleAllRequested="OnToggleAllPackages" SelectionToggled="OnPackageSelectionToggled">
                    <controls:OnlyWingetTableColumn Header="Name" BindingPath="Name" Width="180" IsPrimary="True" />
                    <controls:OnlyWingetTableColumn Header="Package ID" BindingPath="PackageId" Width="240" IsTextSelectable="True" />
                    <controls:OnlyWingetTableColumn Header="Source" BindingPath="Source" Width="120" />
                    <controls:OnlyWingetTableColumn Header="Version" BindingPath="Version" Width="110" />
                    <controls:OnlyWingetTableColumn Header="Publisher" BindingPath="Publisher" Width="*" />
                </controls:OnlyWingetTable>
            </Border>
            <StackPanel Grid.Row="4" Spacing="8">
                <TextBlock x:Name="OperationResultsText" Style="{StaticResource SectionTitleTextBlockStyle}" Visibility="{x:Bind presentation:PresentationValues.Visibility(ViewModel.HasOperationResults), Mode=OneWay}"/>
                <Border Style="{StaticResource ListCardStyle}" Visibility="{x:Bind presentation:PresentationValues.Visibility(ViewModel.HasOperationResults), Mode=OneWay}">
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="OperationResultList" ItemsSource="{x:Bind ViewModel.OperationResults}" AutomationProperties.AutomationId="PresetOperationResultList" Padding="12,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="appPresentation:OperationResultRow">
                                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="180" />
                                                <ColumnDefinition Width="Auto" MinWidth="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind PackageId, Mode=OneTime}" Style="{StaticResource RowPrimaryTextBlockStyle}" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Status, Mode=OneTime}" Style="{StaticResource RowSecondaryTextBlockStyle}" Foreground="{x:Bind presentation:PresentationValues.StatusBrush(Succeeded, IsWarning), Mode=OneTime}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind ErrorDetails, Mode=OneTime}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource RowSecondaryTextBlockStyle}" VerticalAlignment="Center" Visibility="{x:Bind presentation:PresentationValues.HasErrorDetails(ErrorDetails), Mode=OneTime}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
