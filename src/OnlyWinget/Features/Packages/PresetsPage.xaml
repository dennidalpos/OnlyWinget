<UserControl x:Class="OnlyWinget.Features.Packages.PresetsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:OnlyWinget.Controls" xmlns:states="using:OnlyWinget.DesignSystem.States" xmlns:commands="using:OnlyWinget.DesignSystem.Commands" xmlns:presentation="using:OnlyWinget.Presentation" xmlns:appPresentation="using:OnlyWinget.Application.Presentation" xmlns:design="using:OnlyWinget.DesignSystem.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid RowSpacing="12" Margin="0,0,0,16">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="WideLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="850" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="NarrowLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PresetCol.Width" Value="*" />
                            <Setter Target="PackageCol.Width" Value="0" />
                            <Setter Target="PackageRow.Height" Value="Auto" />
                            <Setter Target="PackageCard.(Grid.Column)" Value="0" />
                            <Setter Target="PackageCard.(Grid.Row)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Style="{StaticResource CardStyle}">
                <commands:OnlyWingetCommandBar x:Name="CommandBar" CommandInvoked="OnCommandInvoked" VerticalAlignment="Center" />
            </Border>
            <Grid x:Name="ManagementGrid" Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PresetCol" Width="*" />
                    <ColumnDefinition x:Name="PackageCol" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="PresetRow" Height="Auto" />
                    <RowDefinition x:Name="PackageRow" Height="0" />
                </Grid.RowDefinitions>

                <!-- Card 1: Preset Management -->
                <Border x:Name="PresetCard" Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <TextBlock x:Name="PresetManagementText" Style="{StaticResource SectionTitleTextBlockStyle}"/>
                        
                        <ComboBox x:Name="PresetSelector" Grid.Row="1" SelectionChanged="OnPresetChanged" AutomationProperties.AutomationId="PresetSelector" Style="{StaticResource FormComboBoxStyle}" HorizontalAlignment="Stretch"/>
                        
                        <TextBox x:Name="PresetNameBox" Grid.Row="2" AutomationProperties.AutomationId="PresetNameTextBox" Style="{StaticResource FormTextBoxStyle}" Text="{x:Bind ViewModel.PresetName.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"/>
                        
                        <design:OnlyWingetWrapPanel Grid.Row="3" HorizontalSpacing="8" VerticalSpacing="8">
                            <Button x:Name="AddPresetBtn" Click="OnAddPresetClick" Style="{StaticResource AddPrimaryButtonStyle}" />
                            <Button x:Name="RenamePresetBtn" Click="OnRenamePresetClick" Style="{StaticResource EditButtonStyle}" />
                            <Button x:Name="RemovePresetBtn" Click="OnRemovePresetClick" Style="{StaticResource DeleteButtonStyle}" />
                            <Button x:Name="ImportPresetBtn" Click="OnImportPresetClick" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button x:Name="ExportPresetBtn" Click="OnExportPresetClick" Style="{StaticResource SecondaryButtonStyle}" />
                        </design:OnlyWingetWrapPanel>
                    </Grid>
                </Border>

                <!-- Card 2: Package Management -->
                <Border x:Name="PackageCard" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <TextBlock x:Name="PackageManagementText" Style="{StaticResource SectionTitleTextBlockStyle}"/>
                        
                        <TextBox x:Name="PackageIdBox" Grid.Row="1" AutomationProperties.AutomationId="PresetPackageIdTextBox" Style="{StaticResource FormTextBoxStyle}" Text="{x:Bind ViewModel.PackageId.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"/>
                        
                        <TextBox x:Name="PackageSourceBox" Grid.Row="2" AutomationProperties.AutomationId="PresetPackageSourceTextBox" Style="{StaticResource FormTextBoxStyle}" HorizontalAlignment="Stretch"/>
                        
                        <design:OnlyWingetWrapPanel Grid.Row="3" HorizontalSpacing="8" VerticalSpacing="8">
                            <Button x:Name="AddPackageBtn" Click="OnAddPackageClick" Style="{StaticResource AddPrimaryButtonStyle}" />
                            <Button x:Name="EditPackageBtn" Click="OnEditPackageClick" Style="{StaticResource EditButtonStyle}" />
                            <Button x:Name="RemovePackageBtn" Click="OnRemovePackageClick" Style="{StaticResource DeleteButtonStyle}" />
                        </design:OnlyWingetWrapPanel>
                    </Grid>
                </Border>
            </Grid>
            <TextBlock x:Name="PackagesSectionText" Grid.Row="2" Style="{StaticResource SectionTitleTextBlockStyle}"/>
            <states:StatePresenter x:Name="PageState" Grid.Row="3"/>
            <Border Grid.Row="4" Style="{StaticResource ListCardStyle}" MinHeight="300">
                <controls:OnlyWingetTable x:Name="PackageList" ItemsSource="{x:Bind ViewModel.Packages}" HeaderSelection="{x:Bind presentation:PresentationValues.HeaderSelection(ViewModel.HeaderState), Mode=OneWay}" AutomationProperties.AutomationId="PresetPackageList" ToggleAllRequested="OnToggleAllPackages" SelectionToggled="OnPackageSelectionToggled">
                    <controls:OnlyWingetTableColumn Header="Name" BindingPath="Name" Width="180" IsPrimary="True"/><controls:OnlyWingetTableColumn Header="Package ID" BindingPath="PackageId" Width="240" IsTextSelectable="True"/><controls:OnlyWingetTableColumn Header="Source" BindingPath="Source" Width="120"/><controls:OnlyWingetTableColumn Header="Version" BindingPath="Version" Width="110"/><controls:OnlyWingetTableColumn Header="Architecture" BindingPath="Architecture" Width="*"/>
                </controls:OnlyWingetTable>
            </Border>
            <StackPanel Grid.Row="5" Spacing="8">
                <TextBlock x:Name="OperationResultsText" Style="{StaticResource SectionTitleTextBlockStyle}" Visibility="{x:Bind presentation:PresentationValues.Visibility(ViewModel.HasOperationResults), Mode=OneWay}"/>
                <Border Style="{StaticResource ListCardStyle}" Visibility="{x:Bind presentation:PresentationValues.Visibility(ViewModel.HasOperationResults), Mode=OneWay}">
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="OperationResultList" ItemsSource="{x:Bind ViewModel.OperationResults}" AutomationProperties.AutomationId="PresetOperationResultList" Padding="12,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="appPresentation:OperationResultRow">
                                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="180" />
                                                <ColumnDefinition Width="Auto" MinWidth="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind PackageId, Mode=OneTime}" Style="{StaticResource RowPrimaryTextBlockStyle}" IsTextSelectionEnabled="True" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Status, Mode=OneTime}" Style="{StaticResource RowSecondaryTextBlockStyle}" Foreground="{x:Bind presentation:PresentationValues.StatusBrush(Succeeded), Mode=OneTime}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind ErrorDetails, Mode=OneTime}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource RowSecondaryTextBlockStyle}" VerticalAlignment="Center" Visibility="{x:Bind presentation:PresentationValues.HasErrorDetails(ErrorDetails), Mode=OneTime}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <TextBlock x:Name="ImportExportText" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
