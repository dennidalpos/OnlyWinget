<Page
    x:Class="OnlyWinget.Features.Packages.PresetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:OnlyWinget.Application.Presentation">
    <ScrollViewer
        x:Name="PageScroller"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled"
        IsVerticalScrollChainingEnabled="True"
        AutomationProperties.AutomationId="PresetsScrollViewer">
        <Grid x:Name="PageContent" MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PageWidePadding}" RowSpacing="{StaticResource PageSectionSpacing}" HorizontalAlignment="Stretch">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100" /></VisualState.StateTriggers></VisualState>
                    <VisualState x:Name="Medium"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720" /></VisualState.StateTriggers><VisualState.Setters><Setter Target="PageContent.Padding" Value="{StaticResource PageMediumPadding}" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Compact"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers><VisualState.Setters>
                        <Setter Target="PageContent.Padding" Value="{StaticResource PageCompactPadding}" />
                        <Setter Target="PresetActions.Orientation" Value="Vertical" /><Setter Target="PresetActions.HorizontalAlignment" Value="Stretch" /><Setter Target="AddPresetButton.HorizontalAlignment" Value="Stretch" /><Setter Target="RenamePresetButton.HorizontalAlignment" Value="Stretch" /><Setter Target="RemovePresetButton.HorizontalAlignment" Value="Stretch" /><Setter Target="SaveWorkspaceButton.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="PackageEditActions.Orientation" Value="Vertical" /><Setter Target="PackageEditActions.HorizontalAlignment" Value="Stretch" /><Setter Target="AddPackageButton.HorizontalAlignment" Value="Stretch" /><Setter Target="EditPackageButton.HorizontalAlignment" Value="Stretch" /><Setter Target="RemovePackageButton.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="PackageActions.Orientation" Value="Vertical" /><Setter Target="PackageActions.HorizontalAlignment" Value="Stretch" /><Setter Target="InstallPresetButton.HorizontalAlignment" Value="Stretch" /><Setter Target="UninstallPresetButton.HorizontalAlignment" Value="Stretch" /><Setter Target="CancelPresetOperationButton.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="ImportActions.Orientation" Value="Vertical" /><Setter Target="ImportPresetButton.HorizontalAlignment" Value="Stretch" /><Setter Target="ExportPresetButton.HorizontalAlignment" Value="Stretch" />
                    </VisualState.Setters></VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="PresetManagementText" Style="{StaticResource SectionTitleTextBlockStyle}" />
                    <StackPanel Spacing="8">
                        <ComboBox x:Name="PresetSelector" MinWidth="0" SelectionChanged="OnPresetChanged" AutomationProperties.AutomationId="PresetSelector" />
                        <TextBox x:Name="PresetNameBox" Style="{StaticResource FormTextBoxStyle}" AutomationProperties.AutomationId="PresetNameTextBox" />
                    </StackPanel>
                    <StackPanel x:Name="PresetActions" Style="{StaticResource ActionBarStyle}">
                        <Button x:Name="AddPresetButton" Style="{StaticResource AddPrimaryButtonStyle}" Click="OnAddPreset" AutomationProperties.AutomationId="PresetAddButton" />
                        <Button x:Name="RenamePresetButton" Style="{StaticResource EditButtonStyle}" Click="OnRenamePreset" AutomationProperties.AutomationId="PresetRenameButton" />
                        <Button x:Name="SaveWorkspaceButton" Style="{StaticResource SaveButtonStyle}" Click="OnSaveWorkspace" AutomationProperties.AutomationId="WorkspaceSaveButton" />
                        <Button x:Name="RemovePresetButton" Style="{StaticResource DeleteButtonStyle}" Click="OnRemovePreset" AutomationProperties.AutomationId="PresetRemoveButton" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="PackageManagementText" Style="{StaticResource SectionTitleTextBlockStyle}" />
                    <StackPanel Spacing="8">
                        <TextBox x:Name="PackageIdBox" Style="{StaticResource FormTextBoxStyle}" AutomationProperties.AutomationId="PresetPackageIdTextBox" />
                        <TextBox x:Name="PackageSourceBox" Style="{StaticResource FormTextBoxStyle}" AutomationProperties.AutomationId="PresetPackageSourceTextBox" />
                    </StackPanel>
                    <StackPanel x:Name="PackageEditActions" Style="{StaticResource ActionBarStyle}">
                        <Button x:Name="AddPackageButton" Style="{StaticResource AddPrimaryButtonStyle}" Click="OnAddPackage" AutomationProperties.AutomationId="PresetPackageAddButton" />
                        <Button x:Name="EditPackageButton" Style="{StaticResource EditButtonStyle}" Click="OnEditPackage" AutomationProperties.AutomationId="PresetPackageEditButton" />
                        <Button x:Name="RemovePackageButton" Style="{StaticResource DeleteButtonStyle}" Click="OnRemovePackages" AutomationProperties.AutomationId="PresetPackageRemoveButton" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel x:Name="PackageActions" Style="{StaticResource ActionBarStyle}">
                        <TextBlock x:Name="PackagesSectionText" Style="{StaticResource SectionTitleTextBlockStyle}" VerticalAlignment="Center" />
                        <CheckBox x:Name="SelectAllPackagesBox" Click="OnToggleAllPackages" VerticalAlignment="Center" AutomationProperties.AutomationId="PresetPackagesSelectAllCheckBox" />
                        <Button x:Name="InstallPresetButton" Style="{StaticResource DownloadPrimaryButtonStyle}" Click="OnInstallPreset" AutomationProperties.AutomationId="PresetInstallButton" />
                        <Button x:Name="UninstallPresetButton" Style="{StaticResource DeleteButtonStyle}" Click="OnUninstallPreset" AutomationProperties.AutomationId="PresetUninstallButton" />
                        <Button x:Name="CancelPresetOperationButton" Style="{StaticResource CancelButtonStyle}" Click="OnCancelPresetOperation" AutomationProperties.AutomationId="PresetOperationCancelButton" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="4">
                        <ProgressBar x:Name="OperationProgressBar" Minimum="0" Maximum="100" AutomationProperties.AutomationId="PresetOperationProgressBar" AutomationProperties.Name="Preset operation progress" />
                        <TextBlock x:Name="OperationProgressText" AutomationProperties.AutomationId="PresetOperationProgressText" AutomationProperties.LiveSetting="Polite" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <ScrollViewer
                            x:Name="PackageTableScroller"
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollMode="Disabled"
                            IsVerticalScrollChainingEnabled="True">
                            <StackPanel>
                                <Border Style="{StaticResource TableHeaderSurfaceStyle}">
                                <Grid Padding="12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Column0Width, Source={StaticResource PresetColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding Column1Width, Source={StaticResource PresetColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding Column2Width, Source={StaticResource PresetColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding Column3Width, Source={StaticResource PresetColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding Column4Width, Source={StaticResource PresetColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding Column5Width, Source={StaticResource PresetColumnLayout}}" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PresetNameHeader" Grid.Column="1" Style="{StaticResource TableHeaderTextBlockStyle}" />
                                <TextBlock x:Name="PresetPackageIdHeader" Grid.Column="2" Style="{StaticResource TableHeaderTextBlockStyle}" />
                                <TextBlock x:Name="PresetSourceHeader" Grid.Column="3" Style="{StaticResource TableHeaderTextBlockStyle}" />
                                <TextBlock x:Name="PresetVersionHeader" Grid.Column="4" Style="{StaticResource TableHeaderTextBlockStyle}" />
                                <TextBlock x:Name="PresetArchitectureHeader" Grid.Column="5" Style="{StaticResource TableHeaderTextBlockStyle}" />
                                </Grid>
                                </Border>
                                <ItemsControl x:Name="PackageList" AutomationProperties.AutomationId="PresetPackageList">
                                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="presentation:PresetPackageRow">
                                    <Grid Padding="12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Column0Width, Source={StaticResource PresetColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding Column1Width, Source={StaticResource PresetColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding Column2Width, Source={StaticResource PresetColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding Column3Width, Source={StaticResource PresetColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding Column4Width, Source={StaticResource PresetColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding Column5Width, Source={StaticResource PresetColumnLayout}}" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    AutomationProperties.AutomationId="{x:Bind PackageId, Mode=OneTime}"
                                    AutomationProperties.Name="{x:Bind PackageId, Mode=OneTime}"
                                    IsChecked="{x:Bind IsSelected, Mode=OneTime}"
                                    Click="OnPackageSelectionClick"
                                    VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneTime}" Style="{StaticResource RowPrimaryTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                <TextBlock Grid.Column="2" Text="{x:Bind PackageId, Mode=OneTime}" Style="{StaticResource TableCellTextBlockStyle}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Source, Mode=OneTime}" Style="{StaticResource TableCellTextBlockStyle}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Version, Mode=OneTime}" Style="{StaticResource TableCellTextBlockStyle}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind Architecture, Mode=OneTime}" Style="{StaticResource TableCellTextBlockStyle}" />
                                <Border Grid.ColumnSpan="6" Style="{StaticResource TableRowDividerStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource TableCellDividerStyle}" />
                                <Border Grid.Column="2" Style="{StaticResource TableCellDividerStyle}" />
                                <Border Grid.Column="3" Style="{StaticResource TableCellDividerStyle}" />
                                <Border Grid.Column="4" Style="{StaticResource TableCellDividerStyle}" />
                                    </Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="ImportExportText" Style="{StaticResource SectionTitleTextBlockStyle}" />
                    <StackPanel x:Name="ImportActions" Style="{StaticResource ActionBarStyle}">
                        <Button x:Name="ImportPresetButton" Style="{StaticResource DownloadPrimaryButtonStyle}" Click="OnImportPreset" AutomationProperties.AutomationId="ImportPresetButton" />
                        <Button x:Name="ExportPresetButton" Style="{StaticResource SaveButtonStyle}" Click="OnExportPreset" AutomationProperties.AutomationId="ExportPresetButton" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="5" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock x:Name="OperationResultsText" Style="{StaticResource SectionTitleTextBlockStyle}" />
                    <ItemsControl x:Name="OperationResultList" Grid.Row="1" AutomationProperties.AutomationId="PresetOperationResultList">
                        <ItemsControl.ItemTemplate><DataTemplate x:DataType="presentation:OperationResultRow">
                            <StackPanel Padding="12,8" Spacing="3">
                                <TextBlock Text="{x:Bind PackageId, Mode=OneTime}" Style="{StaticResource RowPrimaryTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Action, Mode=OneTime}" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Status, Mode=OneTime}" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Source, Mode=OneTime}" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ErrorDetails, Mode=OneTime}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="StatusText" Grid.Row="2" AutomationProperties.LiveSetting="Polite" Style="{StaticResource EmptyStateTextBlockStyle}" />
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</Page>
