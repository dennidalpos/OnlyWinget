<UserControl x:Class="OnlyWinget.Features.Packages.PresetsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:OnlyWinget.Controls" xmlns:states="using:OnlyWinget.DesignSystem.States" xmlns:commands="using:OnlyWinget.DesignSystem.Commands" xmlns:presentation="using:OnlyWinget.Presentation" xmlns:appPresentation="using:OnlyWinget.Application.Presentation" xmlns:design="using:OnlyWinget.DesignSystem.Controls" xmlns:services="using:OnlyWinget.Services">
    <Grid RowSpacing="12" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}">
            <design:OnlyWingetResponsivePanel ItemMinWidth="320" HorizontalSpacing="16" VerticalSpacing="12">
                <!-- Left Section: Preset Selector and Preset Actions -->
                <design:OnlyWingetWrapPanel HorizontalSpacing="8" VerticalSpacing="8" VerticalAlignment="Center">
                    <ComboBox x:Name="PresetSelector" SelectionChanged="OnPresetChanged" AutomationProperties.AutomationId="PresetSelector" Style="{StaticResource FormComboBoxStyle}" Width="160" VerticalAlignment="Center"/>
                    
                    <!-- Add Preset Compact Icon Button -->
                    <Button x:Name="AddPresetBtn" ToolTipService.ToolTip="{services:Localize Key=Command_Preset_Add}" AutomationProperties.Name="{services:Localize Key=Command_Preset_Add}" AutomationProperties.AutomationId="AddPresetBtn" VerticalAlignment="Center" Padding="8,6">
                        <SymbolIcon Symbol="Add" />
                        <Button.Flyout>
                            <Flyout x:Name="AddPresetFlyout" Opened="OnPendingFlyoutOpened" Closed="OnPendingFlyoutClosed">
                                <StackPanel Spacing="8" Width="240">
                                    <TextBox x:Name="PresetNameBox" Header="{services:Localize Key=Preset_Name}" AutomationProperties.AutomationId="PresetNameTextBox" Style="{StaticResource FormTextBoxStyle}" Text="{x:Bind ViewModel.PresetName.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"/>
                                    <Button x:Name="SavePresetBtn" Content="{services:Localize Key=Command_Preset_Add}" AutomationProperties.AutomationId="SavePresetBtn" Click="OnAddPresetClick" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    
                    <!-- Rename Preset Compact Icon Button -->
                    <Button x:Name="RenamePresetBtn" ToolTipService.ToolTip="{services:Localize Key=Command_Preset_Rename}" AutomationProperties.Name="{services:Localize Key=Command_Preset_Rename}" AutomationProperties.AutomationId="RenamePresetBtn" VerticalAlignment="Center" Padding="8,6">
                        <SymbolIcon Symbol="Edit" />
                        <Button.Flyout>
                            <Flyout x:Name="RenamePresetFlyout" Opened="OnPendingFlyoutOpened" Closed="OnPendingFlyoutClosed">
                                <StackPanel Spacing="8" Width="240">
                                    <TextBox x:Name="RenamePresetNameBox" Header="{services:Localize Key=Preset_Name}" AutomationProperties.AutomationId="RenamePresetNameTextBox" Style="{StaticResource FormTextBoxStyle}" Text="{x:Bind ViewModel.PresetName.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"/>
                                    <Button x:Name="SaveRenamePresetBtn" Content="{services:Localize Key=Command_Preset_Rename}" AutomationProperties.AutomationId="SaveRenamePresetBtn" Click="OnRenamePresetClick" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Delete Preset Compact Icon Button -->
                    <Button x:Name="RemovePresetBtn" ToolTipService.ToolTip="{services:Localize Key=Command_Preset_Remove}" AutomationProperties.Name="{services:Localize Key=Command_Preset_Remove}" Click="OnRemovePresetClick" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.AutomationId="RemovePresetBtn" VerticalAlignment="Center" Padding="8,6">
                        <SymbolIcon Symbol="Delete" />
                    </Button>

                    <!-- Import/Export Compact Icon Buttons -->
                    <Button x:Name="ImportPresetBtn" ToolTipService.ToolTip="{services:Localize Key=Command_Preset_Import}" AutomationProperties.Name="{services:Localize Key=Command_Preset_Import}" Click="OnImportPresetClick" AutomationProperties.AutomationId="ImportPresetBtn" VerticalAlignment="Center" Padding="8,6">
                        <SymbolIcon Symbol="Import" />
                    </Button>
                    <Button x:Name="ExportPresetBtn" ToolTipService.ToolTip="{services:Localize Key=Command_Preset_Export}" AutomationProperties.Name="{services:Localize Key=Command_Preset_Export}" Click="OnExportPresetClick" AutomationProperties.AutomationId="ExportPresetBtn" VerticalAlignment="Center" Padding="8,6">
                        <SymbolIcon Symbol="Share" />
                    </Button>

                    <AppBarSeparator VerticalAlignment="Center" Margin="4,0" />

                    <!-- Package Management Buttons -->
                    <Button x:Name="AddPackageBtn" Content="{services:Localize Key=Command_PresetPackage_Add}" Style="{StaticResource AddPrimaryButtonStyle}" AutomationProperties.AutomationId="AddPackageBtn" VerticalAlignment="Center">
                        <Button.Flyout>
                            <Flyout x:Name="AddPackageFlyout" Opened="OnPendingFlyoutOpened" Closed="OnPendingFlyoutClosed">
                                <StackPanel Spacing="8" Width="240">
                                    <TextBox x:Name="PackageIdBox" Header="{services:Localize Key=Package_Id}" AutomationProperties.AutomationId="PresetPackageIdTextBox" Style="{StaticResource FormTextBoxStyle}" Text="{x:Bind ViewModel.PackageId.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"/>
                                    <TextBox x:Name="PackageSourceBox" Header="{services:Localize Key=Package_Source}" AutomationProperties.AutomationId="PresetPackageSourceTextBox" Style="{StaticResource FormTextBoxStyle}" HorizontalAlignment="Stretch"/>
                                    <Button x:Name="SavePackageBtn" Content="{services:Localize Key=Command_PresetPackage_Add}" AutomationProperties.AutomationId="SavePackageBtn" Click="OnAddPackageClick" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button x:Name="EditPackageBtn" Content="{services:Localize Key=Command_PresetPackage_Edit}" Style="{StaticResource EditButtonStyle}" AutomationProperties.AutomationId="EditPackageBtn" VerticalAlignment="Center">
                        <Button.Flyout>
                            <Flyout x:Name="EditPackageFlyout" Opened="OnEditPackageFlyoutOpened" Closed="OnPendingFlyoutClosed">
                                <StackPanel Spacing="8" Width="240">
                                    <TextBox x:Name="EditPackageIdBox" Header="{services:Localize Key=Package_Id}" AutomationProperties.AutomationId="EditPackageIdTextBox" Style="{StaticResource FormTextBoxStyle}" Text="{x:Bind ViewModel.PackageId.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"/>
                                    <TextBox x:Name="EditPackageSourceBox" Header="{services:Localize Key=Package_Source}" AutomationProperties.AutomationId="EditPackageSourceTextBox" Style="{StaticResource FormTextBoxStyle}" HorizontalAlignment="Stretch"/>
                                    <Button x:Name="SaveEditPackageBtn" Content="{services:Localize Key=Command_PresetPackage_Edit}" AutomationProperties.AutomationId="SaveEditPackageBtn" Click="OnEditPackageClick" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button x:Name="RemovePackageBtn" Content="{services:Localize Key=Command_PresetPackage_Remove}" Click="OnRemovePackageClick" Style="{StaticResource DeleteButtonStyle}" AutomationProperties.AutomationId="RemovePackageBtn" VerticalAlignment="Center"/>
                </design:OnlyWingetWrapPanel>

                <!-- Right Section: Execution CommandBar -->
                <commands:OnlyWingetCommandBar x:Name="CommandBar" CommandInvoked="OnCommandInvoked" VerticalAlignment="Center" />
            </design:OnlyWingetResponsivePanel>
        </Border>
        
        <states:StatePresenter x:Name="PageState" Grid.Row="1"/>
        <Border Grid.Row="2" Style="{StaticResource ListCardStyle}">
            <controls:OnlyWingetTable x:Name="PackageList" ItemsSource="{x:Bind ViewModel.Packages}" HeaderSelection="{x:Bind presentation:PresentationValues.HeaderSelection(ViewModel.HeaderState), Mode=OneWay}" SelectionLabel="{services:Localize Key=Preset_PackageSelectionLabel}" AutomationProperties.AutomationId="PresetPackageList" ToggleAllRequested="OnToggleAllPackages" BatchSelectionChanged="OnPackageBatchSelectionChanged" PasteRequested="OnPackageListPasteRequested">
                <controls:OnlyWingetTableColumn Header="{services:Localize Key=Header_Name}" BindingPath="Name" Width="180" IsPrimary="True" />
                <controls:OnlyWingetTableColumn Header="{services:Localize Key=Header_PackageId}" BindingPath="PackageId" Width="240" IsTextSelectable="True" />
                <controls:OnlyWingetTableColumn Header="{services:Localize Key=Header_Source}" BindingPath="Source" Width="120" />
                <controls:OnlyWingetTableColumn Header="{services:Localize Key=Header_Version}" BindingPath="Version" Width="110" />
                <controls:OnlyWingetTableColumn Header="{services:Localize Key=Header_Publisher}" BindingPath="Publisher" Width="*" />
            </controls:OnlyWingetTable>
        </Border>
    </Grid>
</UserControl>
