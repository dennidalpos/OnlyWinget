<UserControl
    x:Class="OnlyWinget.Features.Packages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OnlyWinget.Controls"
    xmlns:states="using:OnlyWinget.DesignSystem.States"
    xmlns:commands="using:OnlyWinget.DesignSystem.Commands"
    xmlns:presentation="using:OnlyWinget.Presentation"
    xmlns:services="using:OnlyWinget.Services">
    <Grid RowSpacing="12" VerticalAlignment="Stretch">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="480" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="QueryBox" PlaceholderText="{services:Localize Key=Search_Query}" Header="{services:Localize Key=Search_Query}" QuerySubmitted="OnQuerySubmitted" AutomationProperties.AutomationId="PackageSearchQuery" HorizontalAlignment="Stretch" />
                <commands:OnlyWingetCommandBar Grid.Column="1" ItemsSource="{x:Bind ViewModel.Commands.Values, Mode=OneWay}" CommandInvoked="OnCommandInvoked" />
            </Grid>
        </Border>
        <states:StatePresenter x:Name="PageState" Grid.Row="1" />
        <Border Grid.Row="2" Style="{StaticResource ListCardStyle}">
            <controls:OnlyWingetTable x:Name="ResultList" ItemsSource="{x:Bind ViewModel.Results}" HeaderSelection="{x:Bind presentation:PresentationValues.HeaderSelection(ViewModel.HeaderState), Mode=OneWay}" SelectionLabel="{services:Localize Key=Command_Select_All}" AutomationProperties.AutomationId="SearchResults" ToggleAllRequested="OnToggleAllResults" BatchSelectionChanged="OnResultBatchSelectionChanged">
                <controls:OnlyWingetTableColumn Header="{services:Localize Key=Header_Name}" BindingPath="Name" Width="190" IsPrimary="True" />
                <controls:OnlyWingetTableColumn Header="{services:Localize Key=Header_PackageId}" BindingPath="PackageId" Width="230" IsTextSelectable="True" />
                <controls:OnlyWingetTableColumn Header="{services:Localize Key=Header_Source}" BindingPath="Source" Width="100" />
                <controls:OnlyWingetTableColumn Header="{services:Localize Key=Header_Version}" BindingPath="Version" Width="100" />
                <controls:OnlyWingetTableColumn Header="{services:Localize Key=Header_Publisher}" BindingPath="Publisher" Width="160" />
                <controls:OnlyWingetTableColumn Header="{services:Localize Key=Header_Match}" BindingPath="Match" Width="*" />
            </controls:OnlyWingetTable>
        </Border>
    </Grid>
</UserControl>
