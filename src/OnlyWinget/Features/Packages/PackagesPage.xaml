<Page
    x:Class="OnlyWinget.Features.Packages.PackagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:design="using:OnlyWinget.DesignSystem.Controls">
    <design:PageScaffold x:Name="Scaffold">
        <design:PageScaffold.Commands>
            <SelectorBar x:Name="ModeSelector" SelectionChanged="OnModeChanged" AutomationProperties.AutomationId="PackagesModes">
                <SelectorBarItem x:Name="PresetMode" Icon="Library" AutomationProperties.AutomationId="PackagesPresetTab" />
                <SelectorBarItem x:Name="SearchMode" Icon="Find" AutomationProperties.AutomationId="PackagesSearchTab" />
            </SelectorBar>
        </design:PageScaffold.Commands>
        <design:PageScaffold.Body>
            <ContentPresenter x:Name="ModeContent" />
        </design:PageScaffold.Body>
    </design:PageScaffold>
</Page>
