<Page
    x:Class="OnlyWinget.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:design="using:OnlyWinget.DesignSystem.Controls">
    <design:PageScaffold x:Name="Scaffold" AreaAccentBrush="{ThemeResource AreaSettingsBrush}">
        <design:PageScaffold.Body>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" Padding="0,0,0,24">
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="LanguageTitle" Style="{StaticResource SectionTitleTextBlockStyle}" />
                                <TextBlock x:Name="LanguageDescription" Style="{StaticResource SubtitleTextBlockStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="LanguagePicker" Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.Language, Mode=TwoWay}" AutomationProperties.AutomationId="SettingsLanguagePicker" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="System default" Tag="system" />
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="Italiano" Tag="it" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="ThemeTitle" Style="{StaticResource SectionTitleTextBlockStyle}" />
                                <TextBlock x:Name="ThemeDescription" Style="{StaticResource SubtitleTextBlockStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="ThemePicker" Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.Theme, Mode=TwoWay}" AutomationProperties.AutomationId="SettingsThemePicker" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="System default" Tag="default" />
                                <ComboBoxItem Content="Light" Tag="light" />
                                <ComboBoxItem Content="Dark" Tag="dark" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ConfirmDestructiveText" Style="{StaticResource SectionTitleTextBlockStyle}" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="ConfirmDestructiveToggle" Grid.Column="1" IsOn="{x:Bind ViewModel.ConfirmDestructiveActions, Mode=TwoWay}" AutomationProperties.AutomationId="SettingsConfirmDestructiveToggle" Header="" Margin="0" VerticalAlignment="Center" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.5" />
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DiagnosticsText" Style="{StaticResource SectionTitleTextBlockStyle}" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="DiagnosticsToggle" Grid.Column="1" IsOn="{x:Bind ViewModel.DiagnosticLogging, Mode=TwoWay}" AutomationProperties.AutomationId="SettingsDiagnosticsToggle" Header="" Margin="0" VerticalAlignment="Center" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.5" />
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="InstallBehaviorText" Style="{StaticResource SectionTitleTextBlockStyle}" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="InstallBehaviorToggle" Grid.Column="1" IsOn="{x:Bind ViewModel.ContinueOperationsAfterFailure, Mode=TwoWay}" AutomationProperties.AutomationId="SettingsInstallBehaviorToggle" Header="" Margin="0" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="ResetTitle" Style="{StaticResource SectionTitleTextBlockStyle}" />
                                <TextBlock x:Name="ResetDescription" Style="{StaticResource SubtitleTextBlockStyle}" />
                            </StackPanel>
                            <Button x:Name="ResetButton" Grid.Column="1" Style="{StaticResource DestructiveButtonStyle}" Click="OnReset" AutomationProperties.AutomationId="SettingsResetButton" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </design:PageScaffold.Body>
    </design:PageScaffold>
</Page>
