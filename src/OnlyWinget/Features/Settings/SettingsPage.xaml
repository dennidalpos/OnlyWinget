<Page
    x:Class="OnlyWinget.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:design="using:OnlyWinget.DesignSystem.Controls">
    <design:PageScaffold x:Name="Scaffold" AreaAccentBrush="{ThemeResource AreaSettingsBrush}">
        <design:PageScaffold.Body>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8" Padding="0,0,0,24" MaxWidth="1000" HorizontalAlignment="Left" Width="800">
                    <!-- Language Setting Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Symbol="Globe" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="LanguageTitle" Style="{StaticResource SectionTitleTextBlockStyle}" />
                                <TextBlock x:Name="LanguageDescription" Style="{StaticResource SubtitleTextBlockStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="LanguagePicker" Grid.Column="2" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.Language, Mode=TwoWay}" AutomationProperties.AutomationId="SettingsLanguagePicker" Width="200" VerticalAlignment="Center">
                                <ComboBoxItem Content="System default" Tag="system" />
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="Italiano" Tag="it" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Theme Setting Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Symbol="Highlight" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="ThemeTitle" Style="{StaticResource SectionTitleTextBlockStyle}" />
                                <TextBlock x:Name="ThemeDescription" Style="{StaticResource SubtitleTextBlockStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="ThemePicker" Grid.Column="2" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.Theme, Mode=TwoWay}" AutomationProperties.AutomationId="SettingsThemePicker" Width="200" VerticalAlignment="Center">
                                <ComboBoxItem Content="System default" Tag="default" />
                                <ComboBoxItem Content="Light" Tag="light" />
                                <ComboBoxItem Content="Dark" Tag="dark" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Confirm Destructive Setting Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Symbol="Important" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="ConfirmDestructiveText" Style="{StaticResource SectionTitleTextBlockStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ConfirmDestructiveToggle" Grid.Column="2" IsOn="{x:Bind ViewModel.ConfirmDestructiveActions, Mode=TwoWay}" AutomationProperties.AutomationId="SettingsConfirmDestructiveToggle" Header="" Margin="0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Diagnostics Setting Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Symbol="Document" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="DiagnosticsText" Style="{StaticResource SectionTitleTextBlockStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="DiagnosticsToggle" Grid.Column="2" IsOn="{x:Bind ViewModel.DiagnosticLogging, Mode=TwoWay}" AutomationProperties.AutomationId="SettingsDiagnosticsToggle" Header="" Margin="0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Install Behavior Setting Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Symbol="Play" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="InstallBehaviorText" Style="{StaticResource SectionTitleTextBlockStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="InstallBehaviorToggle" Grid.Column="2" IsOn="{x:Bind ViewModel.ContinueOperationsAfterFailure, Mode=TwoWay}" AutomationProperties.AutomationId="SettingsInstallBehaviorToggle" Header="" Margin="0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Reset Setting Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Symbol="Refresh" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="ResetTitle" Style="{StaticResource SectionTitleTextBlockStyle}" />
                                <TextBlock x:Name="ResetDescription" Style="{StaticResource SubtitleTextBlockStyle}" />
                            </StackPanel>
                            <Button x:Name="ResetButton" Grid.Column="2" Style="{StaticResource DestructiveButtonStyle}" Click="OnReset" AutomationProperties.AutomationId="SettingsResetButton" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </design:PageScaffold.Body>
    </design:PageScaffold>
</Page>
