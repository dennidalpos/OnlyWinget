<Page
    x:Class="OnlyWinget.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:design="using:OnlyWinget.DesignSystem.Controls">
    <design:PageScaffold x:Name="Scaffold" AreaAccentBrush="{ThemeResource AreaSettingsBrush}">
        <design:PageScaffold.Body>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" Padding="0,0,0,24">
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="LanguageTitle" Style="{StaticResource SectionTitleTextBlockStyle}" />
                                <TextBlock x:Name="LanguageDescription" Style="{StaticResource SubtitleTextBlockStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="LanguagePicker" Grid.Column="1" SelectedIndex="0" SelectionChanged="OnLanguageChanged" AutomationProperties.AutomationId="SettingsLanguagePicker" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="System default" Tag="system" />
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="Italiano" Tag="it" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="ThemeTitle" Style="{StaticResource SectionTitleTextBlockStyle}" />
                                <TextBlock x:Name="ThemeDescription" Style="{StaticResource SubtitleTextBlockStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="ThemePicker" Grid.Column="1" SelectedIndex="0" SelectionChanged="OnThemeChanged" AutomationProperties.AutomationId="SettingsThemePicker" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="System default" Tag="default" />
                                <ComboBoxItem Content="Light" Tag="light" />
                                <ComboBoxItem Content="Dark" Tag="dark" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <ToggleSwitch x:Name="ConfirmDestructiveToggle" Toggled="OnSettingToggled" AutomationProperties.AutomationId="SettingsConfirmDestructiveToggle" />
                            <ToggleSwitch x:Name="DiagnosticsToggle" Toggled="OnSettingToggled" AutomationProperties.AutomationId="SettingsDiagnosticsToggle" />
                            <ToggleSwitch x:Name="InstallBehaviorToggle" Toggled="OnSettingToggled" AutomationProperties.AutomationId="SettingsInstallBehaviorToggle" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="ResetTitle" Style="{StaticResource SectionTitleTextBlockStyle}" />
                            <TextBlock x:Name="ResetDescription" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Button x:Name="ResetButton" Style="{StaticResource DestructiveButtonStyle}" Click="OnReset" HorizontalAlignment="Left" AutomationProperties.AutomationId="SettingsResetButton" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </design:PageScaffold.Body>
    </design:PageScaffold>
</Page>
