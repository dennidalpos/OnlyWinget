<Page
    x:Class="OnlyWinget.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:design="using:OnlyWinget.DesignSystem.Controls"
    xmlns:services="using:OnlyWinget.Services">
    <design:PageScaffold x:Name="Scaffold" Title="{services:Localize Key=Settings_Title}" Subtitle="{services:Localize Key=Settings_Subtitle}" AreaAccentBrush="{ThemeResource AreaSettingsBrush}">
        <design:PageScaffold.Body>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1000" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="8" Padding="0,0,0,24" HorizontalAlignment="Stretch">
                    <!-- Appearance & Language Section -->
                    <TextBlock x:Name="AppearanceGroupHeader" Text="{services:Localize Key=Settings_Group_Appearance}" Style="{StaticResource SectionTitleTextBlockStyle}" Margin="0,12,0,8" />
                    
                    <!-- Language Setting Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Symbol="Globe" VerticalAlignment="Center" Foreground="{ThemeResource SystemAccentColor}" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="LanguageTitle" Text="{services:Localize Key=Settings_Language}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="LanguageDescription" Text="{services:Localize Key=Settings_LanguageDescription}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="LanguagePicker" Grid.Column="2" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.Language, Mode=TwoWay}" AutomationProperties.AutomationId="SettingsLanguagePicker" Width="200" VerticalAlignment="Center">
                                <ComboBoxItem Content="System default" Tag="system" />
                                <ComboBoxItem Content="English" Tag="en" />
                                <ComboBoxItem Content="Italiano" Tag="it" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Theme Setting Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Symbol="Highlight" VerticalAlignment="Center" Foreground="{ThemeResource SystemAccentColor}" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="ThemeTitle" Text="{services:Localize Key=Settings_Theme}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="ThemeDescription" Text="{services:Localize Key=Settings_ThemeDescription}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="ThemePicker" Grid.Column="2" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.Theme, Mode=TwoWay}" AutomationProperties.AutomationId="SettingsThemePicker" Width="200" VerticalAlignment="Center">
                                <ComboBoxItem Content="System default" Tag="default" />
                                <ComboBoxItem Content="Light" Tag="light" />
                                <ComboBoxItem Content="Dark" Tag="dark" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Safety & Behavior Section -->
                    <TextBlock x:Name="BehaviorGroupHeader" Text="{services:Localize Key=Settings_Group_Behavior}" Style="{StaticResource SectionTitleTextBlockStyle}" Margin="0,20,0,8" />

                    <!-- Confirm Destructive Setting Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Symbol="Important" VerticalAlignment="Center" Foreground="{ThemeResource SystemAccentColor}" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="ConfirmDestructiveText" Text="{services:Localize Key=Settings_ConfirmDestructive}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ConfirmDestructiveToggle" Grid.Column="2" IsOn="{x:Bind ViewModel.ConfirmDestructiveActions, Mode=TwoWay}" AutomationProperties.AutomationId="SettingsConfirmDestructiveToggle" Header="" Margin="0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Diagnostics Setting Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Symbol="Document" VerticalAlignment="Center" Foreground="{ThemeResource SystemAccentColor}" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="DiagnosticsText" Text="{services:Localize Key=Settings_Diagnostics}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="DiagnosticsToggle" Grid.Column="2" IsOn="{x:Bind ViewModel.DiagnosticLogging, Mode=TwoWay}" AutomationProperties.AutomationId="SettingsDiagnosticsToggle" Header="" Margin="0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Log Level Setting Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Symbol="List" VerticalAlignment="Center" Foreground="{ThemeResource SystemAccentColor}" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="LogLevelTitle" Text="{services:Localize Key=Settings_LogLevel}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="LogLevelDescription" Text="{services:Localize Key=Settings_LogLevelDescription}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="LogLevelPicker" Grid.Column="2" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.LogLevel, Mode=TwoWay}" AutomationProperties.AutomationId="SettingsLogLevelPicker" Width="200" VerticalAlignment="Center">
                                <ComboBoxItem Content="Verbose (Vrb)" Tag="Verbose" />
                                <ComboBoxItem Content="Information (Info)" Tag="Information" />
                                <ComboBoxItem Content="Warning (Warn)" Tag="Warning" />
                                <ComboBoxItem Content="Error (Err)" Tag="Error" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Install Behavior Setting Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Symbol="Play" VerticalAlignment="Center" Foreground="{ThemeResource SystemAccentColor}" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="InstallBehaviorText" Text="{services:Localize Key=Settings_InstallBehavior}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="InstallBehaviorToggle" Grid.Column="2" IsOn="{x:Bind ViewModel.ContinueOperationsAfterFailure, Mode=TwoWay}" AutomationProperties.AutomationId="SettingsInstallBehaviorToggle" Header="" Margin="0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Maintenance Section -->
                    <TextBlock x:Name="MaintenanceGroupHeader" Text="{services:Localize Key=Settings_Group_Maintenance}" Style="{StaticResource SectionTitleTextBlockStyle}" Margin="0,20,0,8" />

                    <!-- Reset Setting Card -->
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon Symbol="Refresh" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="ResetTitle" Text="{services:Localize Key=Settings_Reset}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="ResetDescription" Text="{services:Localize Key=Settings_ResetDescription}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="ResetButton" Content="{services:Localize Key=Settings_ResetAction}" Grid.Column="2" Style="{StaticResource DestructiveButtonStyle}" Click="OnReset" AutomationProperties.AutomationId="SettingsResetButton" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </design:PageScaffold.Body>
    </design:PageScaffold>
</Page>
