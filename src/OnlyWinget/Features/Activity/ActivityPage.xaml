<Page
    x:Class="OnlyWinget.Features.Activity.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:design="using:OnlyWinget.DesignSystem.Controls"
    xmlns:commands="using:OnlyWinget.DesignSystem.Commands"
    xmlns:states="using:OnlyWinget.DesignSystem.States"
    xmlns:presentation="using:OnlyWinget.Presentation"
    xmlns:appPresentation="using:OnlyWinget.Application.Presentation"
    xmlns:activity="using:OnlyWinget.Features.Activity"
    xmlns:services="using:OnlyWinget.Services">
    <design:PageScaffold x:Name="Scaffold" Title="{services:Localize Key=Activity_Title}" Subtitle="{services:Localize Key=Activity_Subtitle}" AreaAccentBrush="{ThemeResource AreaActivityBrush}">
        <design:PageScaffold.Commands>
            <commands:OnlyWingetCommandBar x:Name="CommandBar" CommandInvoked="OnCommandInvoked" />
        </design:PageScaffold.Commands>
        <design:PageScaffold.State>
            <states:StatePresenter x:Name="PageState" />
        </design:PageScaffold.State>
        <design:PageScaffold.Body>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox x:Name="SearchBox" PlaceholderText="{services:Localize Key=Activity_Search}" QueryIcon="Find" TextChanged="OnSearchChanged" HorizontalAlignment="Stretch" MaxWidth="480" VerticalAlignment="Center" />
                        <ComboBox x:Name="SeverityFilter" Grid.Column="1" SelectedIndex="0" SelectionChanged="OnFilterChanged" MinWidth="140" VerticalAlignment="Center">
                            <ComboBoxItem Content="{services:Localize Key=Activity_AllSeverities}" Tag="all" />
                            <ComboBoxItem Content="{services:Localize Key=Activity_Severity_Information}" Tag="Information" />
                            <ComboBoxItem Content="{services:Localize Key=Activity_Severity_Success}" Tag="Success" />
                            <ComboBoxItem Content="{services:Localize Key=Activity_Severity_Warning}" Tag="Warning" />
                            <ComboBoxItem Content="{services:Localize Key=Activity_Severity_Error}" Tag="Error" />
                        </ComboBox>
                        <ComboBox x:Name="CategoryFilter" Grid.Column="2" SelectedIndex="0" SelectionChanged="OnFilterChanged" MinWidth="140" VerticalAlignment="Center">
                            <ComboBoxItem Content="{services:Localize Key=Activity_Category_AllCategories}" Tag="all" />
                            <ComboBoxItem Content="{services:Localize Key=Activity_Category_Packages}" Tag="packages" />
                            <ComboBoxItem Content="{services:Localize Key=Activity_Category_WindowsUpdate}" Tag="windows" />
                            <ComboBoxItem Content="{services:Localize Key=Activity_Category_Sources}" Tag="sources" />
                            <ComboBoxItem Content="{services:Localize Key=Activity_Category_Presets}" Tag="presets" />
                            <ComboBoxItem Content="{services:Localize Key=Activity_Category_System}" Tag="system" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ActivityTimeFilterBox" PlaceholderText="{x:Bind presentation:PresentationValues.FormatFilterPlaceholder('Header_Time')}" TextChanged="OnActivityColumnFilterChanged" />
                    <TextBox x:Name="ActivitySeverityFilterBox" PlaceholderText="{x:Bind presentation:PresentationValues.FormatFilterPlaceholder('Header_Severity')}" Grid.Column="1" TextChanged="OnActivityColumnFilterChanged" />
                    <TextBox x:Name="ActivityTitleFilterBox" PlaceholderText="{x:Bind presentation:PresentationValues.FormatFilterPlaceholder('Header_Title')}" Grid.Column="2" TextChanged="OnActivityColumnFilterChanged" />
                    <TextBox x:Name="ActivityMessageFilterBox" PlaceholderText="{x:Bind presentation:PresentationValues.FormatFilterPlaceholder('Header_Message')}" Grid.Column="3" TextChanged="OnActivityColumnFilterChanged" />
                </Grid>
                <ListView x:Name="ActivityList" Grid.Row="2" SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource ListRowContainerStyle}">
                            <Setter Property="Padding" Value="0,4" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="appPresentation:ActivityRow">
                            <Expander>
                                <Expander.Header>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Timestamp}" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind activity:ActivityViewModel.LocalizeSeverity(Severity), Mode=OneTime}" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Title}" Style="{StaticResource RowPrimaryTextBlockStyle}" />
                                    </Grid>
                                </Expander.Header>
                                <StackPanel Spacing="8" Margin="0,8,0,12">
                                    <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{x:Bind Timestamp}" Style="{StaticResource RowSecondaryTextBlockStyle}" IsTextSelectionEnabled="True" />
                                    <Button Content="{x:Bind activity:ActivityViewModel.CopyLabel}" Tag="{x:Bind}" Click="OnCopyDetails" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </design:PageScaffold.Body>
    </design:PageScaffold>
</Page>
