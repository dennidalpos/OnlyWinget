<Window x:Class="OnlyWinget.Dialogs.PackageInterrogationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="720"
        Height="800"
        MinWidth="680"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Border Style="{StaticResource CardBorderStyle}" Margin="{StaticResource AppContentMargin}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="12"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Style="{StaticResource DialogHeroTitleTextStyle}"
                     Text="{Binding Title}"/>

          <StackPanel Margin="{StaticResource TopSpacing12}"
                      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource SectionBodyTextStyle}"
                       Text="{Binding LoadingText}"/>
            <ProgressBar Margin="{StaticResource TopSpacing8}"
                         IsIndeterminate="True"/>
          </StackPanel>

          <StackPanel Margin="{StaticResource TopSpacing12}"
                      Visibility="{Binding IsReducedMode, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource SectionBodyTextStyle}"
                       Text="{Binding ReducedModeText}"/>
          </StackPanel>

          <Border Margin="{StaticResource TopSpacing12}"
                  Style="{StaticResource SubtleCardBorderStyle}"
                  Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                         Text="{Binding WarningsTitle}"/>
              <TextBlock Margin="{StaticResource TopSpacing8}"
                         Style="{StaticResource SectionBodyTextStyle}"
                         Text="{Binding WarningsText}"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Border Margin="{StaticResource TopSpacing16}"
                  Style="{StaticResource DialogFieldPanelBorderStyle}"
                  Visibility="{Binding IsContentReady, Converter={StaticResource BoolToVisibility}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource CaptionTextStyle}" Text="{Binding PackageNameLabel}"/>
              <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource SectionBodyTextStyle}" Text="{Binding PackageName}" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Margin="{StaticResource TopSpacing8}" Style="{StaticResource CaptionTextStyle}" Text="{Binding PackageIdLabel}"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Margin="{StaticResource TopSpacing8}" Style="{StaticResource SectionBodyTextStyle}" Text="{Binding PackageId}" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="2" Grid.Column="0" Margin="{StaticResource TopSpacing8}" Style="{StaticResource CaptionTextStyle}" Text="{Binding PackageVersionLabel}"/>
              <TextBlock Grid.Row="2" Grid.Column="1" Margin="{StaticResource TopSpacing8}" Style="{StaticResource SectionBodyTextStyle}" Text="{Binding Version}"/>
              <TextBlock Grid.Row="3" Grid.Column="0" Margin="{StaticResource TopSpacing8}" Style="{StaticResource CaptionTextStyle}" Text="{Binding SourceLabel}"/>
              <TextBlock Grid.Row="3" Grid.Column="1" Margin="{StaticResource TopSpacing8}" Style="{StaticResource SectionBodyTextStyle}" Text="{Binding Source}"/>
              <TextBlock Grid.Row="4" Grid.Column="0" Margin="{StaticResource TopSpacing8}" Style="{StaticResource CaptionTextStyle}" Text="{Binding DetectedInstallerTypeLabel}"/>
              <TextBlock Grid.Row="4" Grid.Column="1" Margin="{StaticResource TopSpacing8}" Style="{StaticResource SectionBodyTextStyle}" Text="{Binding InstallerType}"/>
            </Grid>
          </Border>

          <Border Margin="{StaticResource TopSpacing18}"
                  Style="{StaticResource DialogFieldPanelBorderStyle}"
                  Visibility="{Binding IsFullModeContentReady, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <Grid Visibility="{Binding HasScopes, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextStyle}" Text="{Binding ScopeLabel}"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableScopes}"
                          SelectedItem="{Binding SelectedScope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
              </Grid>

              <Grid Margin="{StaticResource TopSpacing10}" Visibility="{Binding HasInstallModes, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextStyle}" Text="{Binding InstallModeLabel}"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableInstallModes}"
                          SelectedItem="{Binding SelectedInstallMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
              </Grid>

              <Grid Margin="{StaticResource TopSpacing10}" Visibility="{Binding HasArchitectures, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextStyle}" Text="{Binding ArchitectureLabel}"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableArchitectures}"
                          SelectedItem="{Binding SelectedArchitecture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
              </Grid>

              <Grid Margin="{StaticResource TopSpacing10}" Visibility="{Binding HasLocales, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextStyle}" Text="{Binding LocaleLabel}"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableLocales}"
                          SelectedItem="{Binding SelectedLocale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
              </Grid>

              <Grid Margin="{StaticResource TopSpacing10}" Visibility="{Binding HasInstallerTypes, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextStyle}" Text="{Binding InstallerTypeLabel}"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableInstallerTypes}"
                          SelectedItem="{Binding SelectedInstallerType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border Margin="{StaticResource TopSpacing18}"
                  Style="{StaticResource DialogFieldPanelBorderStyle}"
                  Visibility="{Binding IsContentReady, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <!-- Install location: disabled + explanation when unsupported -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource CaptionTextStyle}" Text="{Binding InstallLocationLabel}"/>
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding InstallLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsLocationSupported}"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Margin="{StaticResource FieldHelpMargin}"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{StaticResource WarningTextBrush}"
                           Text="{Binding LocationUnsupportedText}"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsLocationNotSupported, Converter={StaticResource BoolToVisibility}}"/>
              </Grid>

              <!-- Log path: disabled + explanation when unsupported -->
              <Grid Margin="{StaticResource TopSpacing10}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource CaptionTextStyle}" Text="{Binding LogPathLabel}"/>
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding LogPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsLogSupported}"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Margin="{StaticResource FieldHelpMargin}"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{StaticResource WarningTextBrush}"
                           Text="{Binding LogUnsupportedText}"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsLogNotSupported, Converter={StaticResource BoolToVisibility}}"/>
              </Grid>

              <Grid Margin="{StaticResource TopSpacing10}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextStyle}" Text="{Binding AdditionalCustomArgsLabel}"/>
                <TextBox Grid.Column="1"
                         Text="{Binding AdditionalCustomArgs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         MinHeight="72"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Advanced section -->
          <Border Margin="{StaticResource TopSpacing18}"
                  Style="{StaticResource SubtleCardBorderStyle}"
                  Visibility="{Binding IsContentReady, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                         Text="{Binding AdvancedTitle}"/>

              <TextBlock Margin="{StaticResource TopSpacing10}"
                         Style="{StaticResource CaptionTextStyle}"
                         Text="{Binding OverrideArgsLabel}"/>
              <TextBox Margin="{StaticResource FieldStackMargin}"
                       Text="{Binding OverrideArgs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       TextWrapping="Wrap"
                       AcceptsReturn="True"
                       MinHeight="72"/>

              <!-- Override warning: shown when user has entered override args -->
              <Border Margin="{StaticResource TopSpacing8}"
                      Style="{StaticResource WarningPanelBorderStyle}"
                      Visibility="{Binding ShowOverrideWarning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource WarningTextStyle}"
                           Text="{Binding OverrideWarningText}"
                           TextWrapping="Wrap"/>
              </Border>

              <!-- Elevation requirement from manifest -->
              <Grid Margin="{StaticResource TopSpacing12}"
                    Visibility="{Binding HasElevationRequirement, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextStyle}" Text="{Binding ElevationRequirementLabel}"/>
                <TextBlock Grid.Column="1" Style="{StaticResource SectionBodyTextStyle}" Text="{Binding ElevationRequirement}" TextWrapping="Wrap"/>
              </Grid>

              <!-- Unsupported arguments -->
              <Grid Margin="{StaticResource TopSpacing10}"
                    Visibility="{Binding HasUnsupportedArguments, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextStyle}" Text="{Binding UnsupportedArgumentsLabel}"/>
                <TextBlock Grid.Column="1" Style="{StaticResource SectionBodyTextStyle}" Text="{Binding UnsupportedArgumentsText}" TextWrapping="Wrap"/>
              </Grid>

              <!-- Command preview -->
              <TextBlock Margin="{StaticResource TopSpacing16}"
                         Style="{StaticResource CaptionTextStyle}"
                         Text="{Binding CommandPreviewLabel}"/>
              <TextBox Margin="{StaticResource FieldStackMargin}"
                       Text="{Binding CommandPreview, Mode=OneWay}"
                       IsReadOnly="True"
                       TextWrapping="Wrap"
                       Background="{StaticResource LogBackgroundBrush}"
                       Foreground="{StaticResource LogForegroundBrush}"
                       FontFamily="{StaticResource MonospaceFontFamily}"
                       FontSize="{StaticResource LogFontSize}"
                       MinHeight="120"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button Grid.Column="1"
                Content="{Binding CancelLabel}"
                MinWidth="132"
                IsCancel="True"
                Style="{StaticResource NeutralButtonStyle}"/>
        <Button Grid.Column="3"
                Content="{Binding ConfirmLabel}"
                MinWidth="164"
                IsEnabled="{Binding CanConfirm}"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="OnConfirmClick"/>
      </Grid>
    </Grid>
  </Border>
</Window>
