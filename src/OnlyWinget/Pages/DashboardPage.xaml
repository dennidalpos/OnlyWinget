<Page
    x:Class="OnlyWinget.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:OnlyWinget.Application.Presentation">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageContent" MaxWidth="1440" Padding="28" RowSpacing="20" HorizontalAlignment="Stretch">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100" /></VisualState.StateTriggers>
                        <VisualState.Setters><Setter Target="CompactMetrics.Visibility" Value="Collapsed" /><Setter Target="WideMetrics.Visibility" Value="Visible" /></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Medium">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageContent.Padding" Value="24" />
                            <Setter Target="CompactMetrics.Visibility" Value="Collapsed" />
                            <Setter Target="WideMetrics.Visibility" Value="Visible" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Compact">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageContent.Padding" Value="16,64,16,16" />
                            <Setter Target="CompactMetrics.Visibility" Value="Visible" />
                            <Setter Target="WideMetrics.Visibility" Value="Collapsed" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource SubtitleTextBlockStyle}" />
            </StackPanel>

            <Grid Grid.Row="1">
            <StackPanel x:Name="CompactMetrics" Spacing="12">
                <Border x:Name="WingetCard" Style="{StaticResource MetricCardStyle}">
                    <StackPanel><TextBlock x:Name="WingetValueText" Style="{StaticResource MetricValueTextBlockStyle}" /><TextBlock x:Name="WingetLabelText" Style="{StaticResource MetricLabelTextBlockStyle}" /></StackPanel>
                </Border>
                <Border x:Name="PresetCard" Style="{StaticResource MetricCardStyle}">
                    <StackPanel><TextBlock x:Name="PresetValueText" Style="{StaticResource MetricValueTextBlockStyle}" /><TextBlock x:Name="PresetLabelText" Style="{StaticResource MetricLabelTextBlockStyle}" /></StackPanel>
                </Border>
                <Border x:Name="SearchCard" Style="{StaticResource MetricCardStyle}">
                    <StackPanel><TextBlock x:Name="SearchValueText" Style="{StaticResource MetricValueTextBlockStyle}" /><TextBlock x:Name="SearchLabelText" Style="{StaticResource MetricLabelTextBlockStyle}" /></StackPanel>
                </Border>
                <Border x:Name="UpdateCard" Style="{StaticResource MetricCardStyle}">
                    <StackPanel><TextBlock x:Name="UpdateValueText" Style="{StaticResource MetricValueTextBlockStyle}" /><TextBlock x:Name="UpdateLabelText" Style="{StaticResource MetricLabelTextBlockStyle}" /></StackPanel>
                </Border>
                <Border x:Name="SourceCard" Style="{StaticResource MetricCardStyle}">
                    <StackPanel><TextBlock x:Name="SourceValueText" Style="{StaticResource MetricValueTextBlockStyle}" /><TextBlock x:Name="SourceLabelText" Style="{StaticResource MetricLabelTextBlockStyle}" /></StackPanel>
                </Border>
            </StackPanel>
            <Grid x:Name="WideMetrics" Visibility="Collapsed" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock x:Name="WideWingetValueText" Style="{StaticResource MetricValueTextBlockStyle}" /><TextBlock x:Name="WideWingetLabelText" Style="{StaticResource MetricLabelTextBlockStyle}" /></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock x:Name="WidePresetValueText" Style="{StaticResource MetricValueTextBlockStyle}" /><TextBlock x:Name="WidePresetLabelText" Style="{StaticResource MetricLabelTextBlockStyle}" /></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock x:Name="WideSearchValueText" Style="{StaticResource MetricValueTextBlockStyle}" /><TextBlock x:Name="WideSearchLabelText" Style="{StaticResource MetricLabelTextBlockStyle}" /></StackPanel></Border>
                <Border Grid.Row="1" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock x:Name="WideUpdateValueText" Style="{StaticResource MetricValueTextBlockStyle}" /><TextBlock x:Name="WideUpdateLabelText" Style="{StaticResource MetricLabelTextBlockStyle}" /></StackPanel></Border>
                <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock x:Name="WideSourceValueText" Style="{StaticResource MetricValueTextBlockStyle}" /><TextBlock x:Name="WideSourceLabelText" Style="{StaticResource MetricLabelTextBlockStyle}" /></StackPanel></Border>
            </Grid>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock x:Name="RecentActivityText" Style="{StaticResource SectionTitleTextBlockStyle}" />
                    <ListView x:Name="ActivityList" Grid.Row="1" ItemContainerStyle="{StaticResource ListRowContainerStyle}" AutomationProperties.AutomationId="DashboardActivityList" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="presentation:ActivityRow">
                                <StackPanel Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind Severity, Mode=OneTime}" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Title, Mode=OneTime}" Style="{StaticResource RowPrimaryTextBlockStyle}" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Message, Mode=OneTime}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="StatusText" Grid.Row="2" AutomationProperties.LiveSetting="Polite" Style="{StaticResource EmptyStateTextBlockStyle}" />
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</Page>
