<Page
    x:Class="OnlyWinget.Pages.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="PageContent" MaxWidth="1440" Padding="28" RowSpacing="20" HorizontalAlignment="Stretch">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100" /></VisualState.StateTriggers></VisualState>
                    <VisualState x:Name="Medium"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720" /></VisualState.StateTriggers><VisualState.Setters><Setter Target="PageContent.Padding" Value="24" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Compact"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers><VisualState.Setters>
                        <Setter Target="PageContent.Padding" Value="16,64,16,16" /><Setter Target="UpdateActions.Orientation" Value="Vertical" /><Setter Target="UpdateActions.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="RefreshButton.HorizontalAlignment" Value="Stretch" /><Setter Target="ApplySelectedButton.HorizontalAlignment" Value="Stretch" /><Setter Target="CancelButton.HorizontalAlignment" Value="Stretch" />
                    </VisualState.Setters></VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel x:Name="UpdateActions" Style="{StaticResource ActionBarStyle}">
                        <CheckBox x:Name="SelectAllUpdatesBox" Click="OnToggleAllUpdates" VerticalAlignment="Center" AutomationProperties.AutomationId="UpdatesSelectAllCheckBox" />
                        <ProgressRing x:Name="LoadingRing" Width="24" Height="24" />
                        <Button x:Name="RefreshButton" Style="{StaticResource RefreshButtonStyle}" Click="OnRefreshUpdates" AutomationProperties.AutomationId="UpdatesRefreshButton" />
                        <Button x:Name="ApplySelectedButton" Style="{StaticResource DownloadPrimaryButtonStyle}" Click="OnApplySelected" AutomationProperties.AutomationId="UpdatesApplySelectedButton" />
                        <Button x:Name="CancelButton" Style="{StaticResource CancelButtonStyle}" Click="OnCancel" AutomationProperties.AutomationId="UpdatesCancelButton" />
                    </StackPanel>
                    <ListView x:Name="UpdateList" Grid.Row="1" ItemContainerStyle="{StaticResource ListRowContainerStyle}" AutomationProperties.AutomationId="UpdateList">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <CheckBox
                                        AutomationProperties.AutomationId="{Binding PackageId}"
                                        AutomationProperties.Name="{Binding Name}"
                                        IsChecked="{Binding IsSelected, Mode=OneWay}"
                                        Click="OnUpdateSelectionClick"
                                        VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource RowPrimaryTextBlockStyle}" />
                                        <TextBlock Text="{Binding PackageId}" Style="{StaticResource RowSecondaryTextBlockStyle}" IsTextSelectionEnabled="True" />
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding InstalledVersion}" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                                            <TextBlock Text="→" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                                            <TextBlock Text="{Binding AvailableVersion}" />
                                            <TextBlock Text="{Binding Source}" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                                        <TextBlock Text="{Binding ErrorDetails}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Spacing="4">
                        <ProgressBar x:Name="OperationProgressBar" Minimum="0" Maximum="100" AutomationProperties.AutomationId="UpdateOperationProgressBar" />
                        <TextBlock x:Name="OperationProgressText" AutomationProperties.LiveSetting="Polite" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Grid.Row="3" AutomationProperties.LiveSetting="Polite" Style="{StaticResource EmptyStateTextBlockStyle}" />
                </Grid>
            </Border>
    </Grid>
</Page>
