<Page
    x:Class="OnlyWinget.Pages.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:presentation="using:OnlyWinget.Application.Presentation">
    <Page.Resources>
        <Style x:Key="UpdateColumnSplitterStyle" TargetType="primitives:Thumb">
            <Setter Property="Width" Value="9" />
            <Setter Property="Margin" Value="0,-8,-5,-8" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Page.Resources>
    <Grid x:Name="PageContent" MaxWidth="1440" Padding="28" RowSpacing="20" HorizontalAlignment="Stretch">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100" /></VisualState.StateTriggers></VisualState>
                    <VisualState x:Name="Medium"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720" /></VisualState.StateTriggers><VisualState.Setters><Setter Target="PageContent.Padding" Value="24" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Compact"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers><VisualState.Setters>
                        <Setter Target="PageContent.Padding" Value="16,64,16,16" /><Setter Target="UpdateActions.Orientation" Value="Vertical" /><Setter Target="UpdateActions.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="RefreshButton.HorizontalAlignment" Value="Stretch" /><Setter Target="ApplySelectedButton.HorizontalAlignment" Value="Stretch" /><Setter Target="CancelButton.HorizontalAlignment" Value="Stretch" />
                    </VisualState.Setters></VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel x:Name="UpdateActions" Style="{StaticResource ActionBarStyle}">
                        <CheckBox x:Name="SelectAllUpdatesBox" Click="OnToggleAllUpdates" VerticalAlignment="Center" AutomationProperties.AutomationId="UpdatesSelectAllCheckBox" />
                        <ProgressRing x:Name="LoadingRing" Width="24" Height="24" AutomationProperties.AutomationId="UpdatesLoadingRing" AutomationProperties.Name="Loading updates" />
                        <Button x:Name="RefreshButton" Style="{StaticResource RefreshButtonStyle}" Click="OnRefreshUpdates" AutomationProperties.AutomationId="UpdatesRefreshButton" />
                        <Button x:Name="ApplySelectedButton" Style="{StaticResource DownloadPrimaryButtonStyle}" Click="OnApplySelected" AutomationProperties.AutomationId="UpdatesApplySelectedButton" />
                        <Button x:Name="CancelButton" Style="{StaticResource CancelButtonStyle}" Click="OnCancel" AutomationProperties.AutomationId="UpdatesCancelButton" />
                    </StackPanel>
                    <ListView
                        x:Name="UpdateList"
                        Grid.Row="1"
                        ItemContainerStyle="{StaticResource ListRowContainerStyle}"
                        AutomationProperties.AutomationId="UpdateList"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollMode="Enabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollMode="Enabled">
                        <ListView.Header>
                            <Border Margin="12,0" Padding="0,8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding SelectionWidth, Source={StaticResource UpdatesColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding NameWidth, Source={StaticResource UpdatesColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding PackageIdWidth, Source={StaticResource UpdatesColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding SourceWidth, Source={StaticResource UpdatesColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding InstalledWidth, Source={StaticResource UpdatesColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding AvailableWidth, Source={StaticResource UpdatesColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding ArchitectureWidth, Source={StaticResource UpdatesColumnLayout}}" />
                                    <ColumnDefinition Width="{Binding StatusWidth, Source={StaticResource UpdatesColumnLayout}}" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="UpdatesNameHeader" Grid.Column="1" TextAlignment="Left" Style="{StaticResource TableHeaderTextBlockStyle}" />
                                <TextBlock x:Name="UpdatesPackageIdHeader" Grid.Column="2" TextAlignment="Left" Style="{StaticResource TableHeaderTextBlockStyle}" />
                                <TextBlock x:Name="UpdatesSourceHeader" Grid.Column="3" TextAlignment="Left" Style="{StaticResource TableHeaderTextBlockStyle}" />
                                <TextBlock x:Name="UpdatesInstalledHeader" Grid.Column="4" TextAlignment="Left" Style="{StaticResource TableHeaderTextBlockStyle}" />
                                <TextBlock x:Name="UpdatesAvailableHeader" Grid.Column="5" TextAlignment="Left" Style="{StaticResource TableHeaderTextBlockStyle}" />
                                <TextBlock x:Name="UpdatesArchitectureHeader" Grid.Column="6" TextAlignment="Left" Style="{StaticResource TableHeaderTextBlockStyle}" />
                                <TextBlock x:Name="UpdatesStatusHeader" Grid.Column="7" TextAlignment="Left" Style="{StaticResource TableHeaderTextBlockStyle}" />
                                <primitives:Thumb Grid.Column="1" Tag="1" Style="{StaticResource UpdateColumnSplitterStyle}" DragDelta="OnColumnSplitterDragDelta" KeyDown="OnColumnSplitterKeyDown" AutomationProperties.Name="Resize name column" />
                                <primitives:Thumb Grid.Column="2" Tag="2" Style="{StaticResource UpdateColumnSplitterStyle}" DragDelta="OnColumnSplitterDragDelta" KeyDown="OnColumnSplitterKeyDown" AutomationProperties.Name="Resize package ID column" />
                                <primitives:Thumb Grid.Column="3" Tag="3" Style="{StaticResource UpdateColumnSplitterStyle}" DragDelta="OnColumnSplitterDragDelta" KeyDown="OnColumnSplitterKeyDown" AutomationProperties.Name="Resize source column" />
                                <primitives:Thumb Grid.Column="4" Tag="4" Style="{StaticResource UpdateColumnSplitterStyle}" DragDelta="OnColumnSplitterDragDelta" KeyDown="OnColumnSplitterKeyDown" AutomationProperties.Name="Resize installed version column" />
                                <primitives:Thumb Grid.Column="5" Tag="5" Style="{StaticResource UpdateColumnSplitterStyle}" DragDelta="OnColumnSplitterDragDelta" KeyDown="OnColumnSplitterKeyDown" AutomationProperties.Name="Resize available version column" />
                                <primitives:Thumb Grid.Column="6" Tag="6" Style="{StaticResource UpdateColumnSplitterStyle}" DragDelta="OnColumnSplitterDragDelta" KeyDown="OnColumnSplitterKeyDown" AutomationProperties.Name="Resize architecture column" />
                                <primitives:Thumb Grid.Column="7" Tag="7" Style="{StaticResource UpdateColumnSplitterStyle}" DragDelta="OnColumnSplitterDragDelta" KeyDown="OnColumnSplitterKeyDown" AutomationProperties.Name="Resize status column" />
                            </Grid>
                            </Border>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="presentation:UpdateRow">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding SelectionWidth, Source={StaticResource UpdatesColumnLayout}}" />
                                        <ColumnDefinition Width="{Binding NameWidth, Source={StaticResource UpdatesColumnLayout}}" />
                                        <ColumnDefinition Width="{Binding PackageIdWidth, Source={StaticResource UpdatesColumnLayout}}" />
                                        <ColumnDefinition Width="{Binding SourceWidth, Source={StaticResource UpdatesColumnLayout}}" />
                                        <ColumnDefinition Width="{Binding InstalledWidth, Source={StaticResource UpdatesColumnLayout}}" />
                                        <ColumnDefinition Width="{Binding AvailableWidth, Source={StaticResource UpdatesColumnLayout}}" />
                                        <ColumnDefinition Width="{Binding ArchitectureWidth, Source={StaticResource UpdatesColumnLayout}}" />
                                        <ColumnDefinition Width="{Binding StatusWidth, Source={StaticResource UpdatesColumnLayout}}" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        AutomationProperties.AutomationId="{x:Bind PackageId, Mode=OneTime}"
                                        AutomationProperties.Name="{x:Bind Name, Mode=OneTime}"
                                        IsChecked="{x:Bind IsSelected, Mode=OneTime}"
                                        Click="OnUpdateSelectionClick"
                                        Width="44"
                                        MinWidth="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneTime}" Style="{StaticResource RowPrimaryTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind PackageId, Mode=OneTime}" Style="{StaticResource TableCellTextBlockStyle}" IsTextSelectionEnabled="True" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Source, Mode=OneTime}" Style="{StaticResource TableCellTextBlockStyle}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind InstalledVersion, Mode=OneTime}" Style="{StaticResource TableCellTextBlockStyle}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind AvailableVersion, Mode=OneTime}" Style="{StaticResource TableCellTextBlockStyle}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind Architecture, Mode=OneTime}" Style="{StaticResource TableCellTextBlockStyle}" />
                                    <StackPanel Grid.Column="7" VerticalAlignment="Center" Spacing="2" ToolTipService.ToolTip="{x:Bind Output, Mode=OneTime}">
                                        <TextBlock Text="{x:Bind Status, Mode=OneTime}" Style="{StaticResource TableCellTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ErrorDetails, Mode=OneTime}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                    <Border Grid.ColumnSpan="8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" IsHitTestVisible="False" />
                                    <Border Grid.Column="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False" />
                                    <Border Grid.Column="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False" />
                                    <Border Grid.Column="3" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False" />
                                    <Border Grid.Column="4" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False" />
                                    <Border Grid.Column="5" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False" />
                                    <Border Grid.Column="6" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" IsHitTestVisible="False" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Spacing="4">
                        <ProgressBar x:Name="DiscoveryProgressBar" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.AutomationId="UpdatesDiscoveryProgressBar" />
                        <TextBlock x:Name="LoadingStatusText" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                        <ProgressBar x:Name="OperationProgressBar" Height="4" Minimum="0" Maximum="100" Visibility="Collapsed" AutomationProperties.AutomationId="UpdateOperationProgressBar" AutomationProperties.Name="Update operation progress" />
                        <TextBlock x:Name="OperationProgressText" AutomationProperties.AutomationId="UpdateOperationProgressText" AutomationProperties.LiveSetting="Polite" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Grid.Row="3" AutomationProperties.LiveSetting="Polite" Style="{StaticResource EmptyStateTextBlockStyle}" />
                </Grid>
            </Border>
    </Grid>
</Page>
