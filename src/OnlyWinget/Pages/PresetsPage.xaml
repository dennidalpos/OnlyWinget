<Page
    x:Class="OnlyWinget.Pages.PresetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />

        <TextBlock x:Name="PresetManagementText" Grid.Row="1" Style="{StaticResource SectionTitleTextBlockStyle}" />

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="PresetSelector" MinWidth="220" SelectionChanged="OnPresetChanged" />
            <TextBox x:Name="PresetNameBox" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}" />
            <Button x:Name="AddPresetButton" Grid.Column="2" Style="{StaticResource CompactButtonStyle}" Click="OnAddPreset" />
            <Button x:Name="RenamePresetButton" Grid.Column="3" Style="{StaticResource CompactButtonStyle}" Click="OnRenamePreset" />
            <Button x:Name="RemovePresetButton" Grid.Column="4" Style="{StaticResource CompactButtonStyle}" Click="OnRemovePreset" />
            <Button x:Name="SaveWorkspaceButton" Grid.Column="5" Style="{StaticResource CompactButtonStyle}" Click="OnSaveWorkspace" />
        </Grid>

        <TextBlock x:Name="PackageManagementText" Grid.Row="3" Style="{StaticResource SectionTitleTextBlockStyle}" />

        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PackageIdBox" Style="{StaticResource FormTextBoxStyle}" />
            <TextBox x:Name="PackageSourceBox" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}" />
            <Button x:Name="AddPackageButton" Grid.Column="2" Style="{StaticResource CompactButtonStyle}" Click="OnAddPackage" />
            <Button x:Name="EditPackageButton" Grid.Column="3" Style="{StaticResource CompactButtonStyle}" Click="OnEditPackage" />
            <Button x:Name="RemovePackageButton" Grid.Column="4" Style="{StaticResource CompactButtonStyle}" Click="OnRemovePackages" />
            <Button x:Name="InstallPresetButton" Grid.Column="5" Style="{StaticResource CompactButtonStyle}" Click="OnInstallPreset" />
        </Grid>

        <Grid Grid.Row="5" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <CheckBox x:Name="SelectAllPackagesBox" Click="OnToggleAllPackages" />
                <Button x:Name="UninstallPresetButton" Style="{StaticResource CompactButtonStyle}" Click="OnUninstallPreset" />
                <Button x:Name="CancelPresetOperationButton" Style="{StaticResource CompactButtonStyle}" Click="OnCancelPresetOperation" />
                <ProgressRing x:Name="OperationRing" Width="24" Height="24" />
            </StackPanel>
            <Grid Grid.Row="1" Padding="0,0,0,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Width="32" />
                <TextBlock x:Name="PackageIdHeaderText" Grid.Column="1" Style="{StaticResource ListHeaderTextBlockStyle}" />
                <TextBlock x:Name="PackageSourceHeaderText" Grid.Column="2" Style="{StaticResource ListHeaderTextBlockStyle}" />
            </Grid>
            <ListView x:Name="PackageList" Grid.Row="2">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}" Click="OnPackageSelectionClick" />
                            <TextBlock Grid.Column="1" Text="{Binding PackageId}" Style="{StaticResource RowPrimaryTextBlockStyle}" />
                            <TextBlock Grid.Column="2" Text="{Binding Source}" Style="{StaticResource RowSecondaryTextBlockStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Row="6" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="ImportExportText" Style="{StaticResource SectionTitleTextBlockStyle}" />
            <TextBox x:Name="ImportJsonBox" Grid.Row="1" AcceptsReturn="True" MaxHeight="88" TextWrapping="Wrap" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="ImportPresetButton" Style="{StaticResource CompactButtonStyle}" Click="OnImportPreset" />
                <Button x:Name="ExportPresetButton" Style="{StaticResource CompactButtonStyle}" Click="OnExportPreset" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource StatusTextBlockStyle}" />
            <ListView x:Name="OperationResultList" Grid.Row="4" MaxHeight="140">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" RowSpacing="2" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding PackageId}" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Text="{Binding Action}" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="3" Text="{Binding Source}" VerticalAlignment="Top" />
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Spacing="2">
                                <TextBlock Text="{Binding ErrorDetails}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock Text="{Binding Output}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
