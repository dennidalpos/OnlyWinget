<Page
    x:Class="OnlyWinget.Pages.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="PageContent" MaxWidth="1440" Padding="28" RowSpacing="20" HorizontalAlignment="Stretch">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100" /></VisualState.StateTriggers></VisualState>
                    <VisualState x:Name="Medium"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720" /></VisualState.StateTriggers><VisualState.Setters><Setter Target="PageContent.Padding" Value="24" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Compact">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageContent.Padding" Value="16,64,16,16" />
                            <Setter Target="ActivityHeader.Orientation" Value="Vertical" />
                            <Setter Target="ActivityHeader.HorizontalAlignment" Value="Stretch" />
                            <Setter Target="ClearButton.HorizontalAlignment" Value="Stretch" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel x:Name="ActivityHeader" Style="{StaticResource ActionBarStyle}" Spacing="12">
                <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                <Button x:Name="ClearButton" Style="{StaticResource DeleteButtonStyle}" Click="OnClearActivity" AutomationProperties.AutomationId="ActivityClearButton" />
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ListView x:Name="ActivityList" ItemContainerStyle="{StaticResource ListRowContainerStyle}" AutomationProperties.AutomationId="ActivityList">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource RowPrimaryTextBlockStyle}" IsTextSelectionEnabled="True" />
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding Timestamp}" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                                        <TextBlock Text="{Binding Severity}" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="StatusText" Grid.Row="1" AutomationProperties.LiveSetting="Polite" Style="{StaticResource EmptyStateTextBlockStyle}" />
                </Grid>
            </Border>
    </Grid>
</Page>
