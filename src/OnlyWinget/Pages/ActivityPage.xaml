<Page
    x:Class="OnlyWinget.Pages.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="ClearButton" Style="{StaticResource CompactButtonStyle}" Click="OnClearActivity" />
        </StackPanel>

        <Grid Grid.Row="2" Padding="0,0,0,4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ActivityTimeHeaderText" Style="{StaticResource ListHeaderTextBlockStyle}" />
            <TextBlock x:Name="ActivitySeverityHeaderText" Grid.Column="1" Style="{StaticResource ListHeaderTextBlockStyle}" />
            <TextBlock x:Name="ActivityTitleHeaderText" Grid.Column="2" Style="{StaticResource ListHeaderTextBlockStyle}" />
            <TextBlock x:Name="ActivityMessageHeaderText" Grid.Column="3" Style="{StaticResource ListHeaderTextBlockStyle}" />
        </Grid>

        <ListView x:Name="ActivityList" Grid.Row="3">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="12" Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Timestamp}" Style="{StaticResource RowSecondaryTextBlockStyle}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding Severity}" Style="{StaticResource RowSecondaryTextBlockStyle}" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="2" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" IsTextSelectionEnabled="True" />
                        <TextBlock Grid.Column="3" Text="{Binding Message}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="StatusText" Grid.Row="4" Style="{StaticResource StatusTextBlockStyle}" />
    </Grid>
</Page>
