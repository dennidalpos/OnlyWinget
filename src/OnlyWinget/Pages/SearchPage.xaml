<Page
    x:Class="OnlyWinget.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="QueryBox" QuerySubmitted="OnQuerySubmitted" MinWidth="280" />
            <TextBox x:Name="SourceBox" Grid.Column="1" />
            <Button x:Name="SearchButton" Grid.Column="2" Click="OnSearch" />
            <Button x:Name="AddSelectedButton" Grid.Column="3" Click="OnAddSelected" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
            <CheckBox x:Name="SelectAllResultsBox" Click="OnToggleAllResults" />
            <ProgressRing x:Name="LoadingRing" Width="24" Height="24" />
        </StackPanel>

        <ListView x:Name="ResultList" Grid.Row="3">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="12" Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}" Click="OnResultSelectionClick" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding PackageId}" Style="{StaticResource RowSecondaryTextBlockStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding Version}" Style="{StaticResource RowSecondaryTextBlockStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{Binding Source}" Style="{StaticResource RowSecondaryTextBlockStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="{Binding Match}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="StatusText" Grid.Row="4" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
    </Grid>
</Page>
