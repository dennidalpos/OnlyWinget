<Page
    x:Class="OnlyWinget.Pages.SourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageContent" MaxWidth="1440" Padding="28" RowSpacing="20" HorizontalAlignment="Stretch">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100" /></VisualState.StateTriggers></VisualState>
                    <VisualState x:Name="Medium"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720" /></VisualState.StateTriggers><VisualState.Setters><Setter Target="PageContent.Padding" Value="24" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Compact"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers><VisualState.Setters>
                        <Setter Target="PageContent.Padding" Value="16,64,16,16" /><Setter Target="AddButton.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="SourceActions.Orientation" Value="Vertical" /><Setter Target="SourceActions.HorizontalAlignment" Value="Stretch" /><Setter Target="RefreshButton.HorizontalAlignment" Value="Stretch" /><Setter Target="UpdateButton.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="DestructiveActions.Orientation" Value="Vertical" /><Setter Target="RemoveButton.HorizontalAlignment" Value="Stretch" /><Setter Target="ResetButton.HorizontalAlignment" Value="Stretch" />
                    </VisualState.Setters></VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock x:Name="AddSourceSectionText" Style="{StaticResource SectionTitleTextBlockStyle}" />
                    <StackPanel Grid.Row="1" Spacing="8">
                        <TextBox x:Name="SourceNameBox" Style="{StaticResource FormTextBoxStyle}" />
                        <TextBox x:Name="SourceArgumentBox" Style="{StaticResource FormTextBoxStyle}" />
                        <Button x:Name="AddButton" Style="{StaticResource AddPrimaryButtonStyle}" Click="OnAddSource" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock x:Name="ManageSourcesSectionText" Style="{StaticResource SectionTitleTextBlockStyle}" />
                    <StackPanel x:Name="SourceActions" Grid.Row="1" Style="{StaticResource ActionBarStyle}">
                        <ProgressRing x:Name="LoadingRing" Width="24" Height="24" />
                        <Button x:Name="RefreshButton" Style="{StaticResource RefreshButtonStyle}" Click="OnRefreshSources" />
                        <Button x:Name="UpdateButton" Style="{StaticResource DownloadPrimaryButtonStyle}" Click="OnUpdateSources" />
                    </StackPanel>
                    <ListView x:Name="SourceList" Grid.Row="2" MaxHeight="520" SelectionMode="Single" ItemContainerStyle="{StaticResource ListRowContainerStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource RowPrimaryTextBlockStyle}" />
                                    <TextBlock Text="{Binding Argument}" Style="{StaticResource RowSecondaryTextBlockStyle}" IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{Binding Type}" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="3" Spacing="10">
                        <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite" Style="{StaticResource EmptyStateTextBlockStyle}" />
                        <StackPanel x:Name="DestructiveActions" Style="{StaticResource ActionBarStyle}">
                            <Button x:Name="RemoveButton" Style="{StaticResource DeleteButtonStyle}" Click="OnRemoveSource" />
                            <Button x:Name="ResetButton" Style="{StaticResource DeleteButtonStyle}" Click="OnResetSources" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
