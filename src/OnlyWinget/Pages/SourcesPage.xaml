<Page
    x:Class="OnlyWinget.Pages.SourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SourceNameBox" Style="{StaticResource FormTextBoxStyle}" />
            <TextBox x:Name="SourceArgumentBox" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}" />
            <Button x:Name="AddButton" Grid.Column="2" Style="{StaticResource CompactButtonStyle}" Click="OnAddSource" />
        </Grid>

        <CommandBar Grid.Row="2" Style="{StaticResource PageToolbarStyle}">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="LoadingRing" Width="24" Height="24" />
                </StackPanel>
            </CommandBar.Content>
            <AppBarButton x:Name="RefreshButton" Icon="Refresh" Click="OnRefreshSources" />
            <AppBarButton x:Name="UpdateButton" Icon="Sync" Click="OnUpdateSources" />
            <AppBarButton x:Name="RemoveButton" Icon="Delete" Click="OnRemoveSource" />
            <AppBarButton x:Name="ResetButton" Icon="Repair" Click="OnResetSources" />
        </CommandBar>

        <Grid Grid.Row="3" Padding="0,0,0,4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SourceNameHeaderText" Style="{StaticResource ListHeaderTextBlockStyle}" />
            <TextBlock x:Name="SourceArgumentHeaderText" Grid.Column="1" Style="{StaticResource ListHeaderTextBlockStyle}" />
            <TextBlock x:Name="SourceTypeHeaderText" Grid.Column="2" Style="{StaticResource ListHeaderTextBlockStyle}" />
            <TextBlock x:Name="SourceStatusHeaderText" Grid.Column="3" Style="{StaticResource ListHeaderTextBlockStyle}" />
        </Grid>

        <ListView x:Name="SourceList" Grid.Row="4" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource RowPrimaryTextBlockStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding Argument}" Style="{StaticResource RowSecondaryTextBlockStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Type}" Style="{StaticResource RowSecondaryTextBlockStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding Status}" Style="{StaticResource RowSecondaryTextBlockStyle}" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="StatusText" Grid.Row="5" Style="{StaticResource StatusTextBlockStyle}" />
    </Grid>
</Page>
