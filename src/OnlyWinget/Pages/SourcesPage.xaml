<Page
    x:Class="OnlyWinget.Pages.SourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SourceNameBox" />
            <TextBox x:Name="SourceArgumentBox" Grid.Column="1" />
            <Button x:Name="AddButton" Grid.Column="2" Click="OnAddSource" />
        </Grid>

        <CommandBar Grid.Row="2" DefaultLabelPosition="Right" IsOpen="False">
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="LoadingRing" Width="24" Height="24" />
                </StackPanel>
            </CommandBar.Content>
            <AppBarButton x:Name="RefreshButton" Icon="Refresh" Click="OnRefreshSources" />
            <AppBarButton x:Name="UpdateButton" Icon="Sync" Click="OnUpdateSources" />
            <AppBarButton x:Name="RemoveButton" Icon="Delete" Click="OnRemoveSource" />
            <AppBarButton x:Name="ResetButton" Icon="Repair" Click="OnResetSources" />
        </CommandBar>

        <ListView x:Name="SourceList" Grid.Row="3" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Argument}" Style="{StaticResource RowSecondaryTextBlockStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding IsExplicit}" Style="{StaticResource RowSecondaryTextBlockStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding Status}" Style="{StaticResource RowSecondaryTextBlockStyle}" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="StatusText" Grid.Row="4" TextWrapping="Wrap" />
    </Grid>
</Page>
