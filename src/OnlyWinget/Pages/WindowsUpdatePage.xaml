<Page
    x:Class="OnlyWinget.Pages.WindowsUpdatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:OnlyWinget.Application.Presentation">
    <Grid x:Name="PageContent" MaxWidth="1440" Padding="28" RowSpacing="20" HorizontalAlignment="Stretch">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100" /></VisualState.StateTriggers></VisualState>
                    <VisualState x:Name="Medium"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720" /></VisualState.StateTriggers><VisualState.Setters><Setter Target="PageContent.Padding" Value="24" /></VisualState.Setters></VisualState>
                    <VisualState x:Name="Compact"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers><VisualState.Setters>
                        <Setter Target="PageContent.Padding" Value="16,64,16,16" /><Setter Target="WindowsUpdateActions.Orientation" Value="Vertical" /><Setter Target="WindowsUpdateActions.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="ScanButton.HorizontalAlignment" Value="Stretch" /><Setter Target="InstallSelectedButton.HorizontalAlignment" Value="Stretch" /><Setter Target="CancelButton.HorizontalAlignment" Value="Stretch" />
                    </VisualState.Setters></VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" />
            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel x:Name="WindowsUpdateActions" Style="{StaticResource ActionBarStyle}">
                        <CheckBox x:Name="SelectAllWindowsUpdatesBox" Click="OnToggleAllWindowsUpdates" VerticalAlignment="Center" AutomationProperties.AutomationId="WindowsUpdatesSelectAllCheckBox" />
                        <CheckBox x:Name="SoftwareUpdatesBox" IsChecked="True" AutomationProperties.AutomationId="SoftwareUpdatesBox" />
                        <CheckBox x:Name="DriverUpdatesBox" IsChecked="True" AutomationProperties.AutomationId="DriverUpdatesBox" />
                        <CheckBox x:Name="MicrosoftUpdatesBox" AutomationProperties.AutomationId="MicrosoftUpdatesBox" />
                        <CheckBox x:Name="SupersededUpdatesBox" AutomationProperties.AutomationId="SupersededUpdatesBox" />
                        <ProgressRing x:Name="LoadingRing" Width="24" Height="24" AutomationProperties.AutomationId="WindowsUpdatesLoadingRing" AutomationProperties.Name="Scanning Windows Update" />
                        <Button x:Name="ScanButton" Style="{StaticResource RefreshButtonStyle}" Click="OnScanWindowsUpdates" AutomationProperties.AutomationId="WindowsUpdatesScanButton" />
                        <Button x:Name="InstallSelectedButton" Style="{StaticResource DownloadPrimaryButtonStyle}" Click="OnInstallSelected" AutomationProperties.AutomationId="WindowsUpdatesInstallSelectedButton" />
                        <Button x:Name="CancelButton" Style="{StaticResource CancelButtonStyle}" Click="OnCancel" AutomationProperties.AutomationId="WindowsUpdatesCancelButton" />
                    </StackPanel>
                    <ListView x:Name="WindowsUpdateList" Grid.Row="1" ItemContainerStyle="{StaticResource ListRowContainerStyle}" AutomationProperties.AutomationId="WindowsUpdateList">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="presentation:WindowsUpdateRow">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <CheckBox
                                        AutomationProperties.AutomationId="{x:Bind UpdateId, Mode=OneTime}"
                                        AutomationProperties.Name="{x:Bind Title, Mode=OneTime}"
                                        IsChecked="{x:Bind IsSelected, Mode=OneTime}"
                                        Click="OnWindowsUpdateSelectionClick"
                                        VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{x:Bind Title, Mode=OneTime}" Style="{StaticResource RowPrimaryTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Severity, Mode=OneTime}" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Categories, Mode=OneTime}" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind IsDownloaded, Mode=OneTime}" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind RebootRequired, Mode=OneTime}" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind UpdateId, Mode=OneTime}" Style="{StaticResource RowSecondaryTextBlockStyle}" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind Status, Mode=OneTime}" Style="{StaticResource RowSecondaryTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Message, Mode=OneTime}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind Description, Mode=OneTime}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="StatusText" Grid.Row="2" AutomationProperties.LiveSetting="Polite" Style="{StaticResource EmptyStateTextBlockStyle}" />
                </Grid>
            </Border>
    </Grid>
</Page>
