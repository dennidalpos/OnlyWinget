<Application
    x:Class="OnlyWinget.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OnlyWinget.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Thickness x:Key="CardPadding">20</Thickness>
            <controls:TableColumnLayout x:Key="UpdatesColumnLayout" />

            <DataTemplate x:Key="AddButtonContentTemplate">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Add" />
                    <TextBlock Text="{Binding}" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="EditButtonContentTemplate">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Edit" />
                    <TextBlock Text="{Binding}" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="DeleteButtonContentTemplate">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Delete" />
                    <TextBlock Text="{Binding}" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="SaveButtonContentTemplate">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Save" />
                    <TextBlock Text="{Binding}" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="RefreshButtonContentTemplate">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Refresh" />
                    <TextBlock Text="{Binding}" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="SearchButtonContentTemplate">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Find" />
                    <TextBlock Text="{Binding}" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="DownloadButtonContentTemplate">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Download" />
                    <TextBlock Text="{Binding}" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="CancelButtonContentTemplate">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Cancel" />
                    <TextBlock Text="{Binding}" />
                </StackPanel>
            </DataTemplate>

            <Style x:Key="PageTitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource PageTitleTextBlockStyle}" />
            <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionTitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="MetricValueTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="MetricLabelTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="RowPrimaryTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="RowSecondaryTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="TableHeaderTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="TableCellTextBlockStyle" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="StatusTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="MinHeight" Value="20" />
            </Style>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Padding" Value="{StaticResource CardPadding}" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
                <Setter Property="MinHeight" Value="96" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="ListRowContainerStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="MinHeight" Value="42" />
            </Style>
            <Style x:Key="ActionBarStyle" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="Spacing" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinWidth" Value="112" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="104" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="DestructiveButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="AddPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="ContentTemplate" Value="{StaticResource AddButtonContentTemplate}" />
            </Style>
            <Style x:Key="EditButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="ContentTemplate" Value="{StaticResource EditButtonContentTemplate}" />
            </Style>
            <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource DestructiveButtonStyle}">
                <Setter Property="ContentTemplate" Value="{StaticResource DeleteButtonContentTemplate}" />
            </Style>
            <Style x:Key="SaveButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="ContentTemplate" Value="{StaticResource SaveButtonContentTemplate}" />
            </Style>
            <Style x:Key="RefreshButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="ContentTemplate" Value="{StaticResource RefreshButtonContentTemplate}" />
            </Style>
            <Style x:Key="SearchPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="ContentTemplate" Value="{StaticResource SearchButtonContentTemplate}" />
            </Style>
            <Style x:Key="DownloadPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="ContentTemplate" Value="{StaticResource DownloadButtonContentTemplate}" />
            </Style>
            <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="ContentTemplate" Value="{StaticResource CancelButtonContentTemplate}" />
            </Style>
            <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
                <Setter Property="MinWidth" Value="160" />
            </Style>
            <Style x:Key="EmptyStateTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusTextBlockStyle}">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="Margin" Value="12,20" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
