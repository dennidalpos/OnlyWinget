<UserControl
    x:Class="OnlyWinget.Controls.OperationTrackerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:OnlyWinget.Services">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="TrackerCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SystemAccentColor}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,12" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="TrackerRoot" Style="{StaticResource TrackerCardStyle}" Margin="0,0,0,12" Visibility="Collapsed">
        <Grid ColumnSpacing="16" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Status Icon -->
            <ProgressRing x:Name="StatusRing" Width="20" Height="20" IsActive="True" VerticalAlignment="Center" />

            <!-- Status Header and Text -->
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="StatusTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{services:Localize Key=Tracker_OperationInProgress}" />
                <TextBlock x:Name="StatusDetail" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Percentage Counter -->
            <TextBlock x:Name="PercentageText" Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" />

            <!-- View Activity Button -->
            <Button x:Name="ViewActivityButton" Grid.Column="3" Click="OnViewActivityClick" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Padding="10,6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <SymbolIcon Symbol="List" />
                    <TextBlock Text="{services:Localize Key=Tracker_ViewActivity}" />
                </StackPanel>
            </Button>

            <!-- Progress Bar -->
            <ProgressBar x:Name="OperationProgressBar" Grid.Row="1" Grid.ColumnSpan="4" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
