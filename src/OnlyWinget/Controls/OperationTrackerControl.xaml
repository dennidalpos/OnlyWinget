<UserControl
    x:Class="OnlyWinget.Controls.OperationTrackerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:OnlyWinget.Services">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="TrackerCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12,8" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="TrackerRoot" Style="{StaticResource TrackerCardStyle}" Margin="0,0,0,8" Visibility="Collapsed">
        <Grid ColumnSpacing="12" RowSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Status Ring / Icon -->
            <Grid Grid.Column="0" VerticalAlignment="Center">
                <ProgressRing x:Name="StatusRing" Width="16" Height="16" IsActive="True" VerticalAlignment="Center" />
                <FontIcon x:Name="StatusIcon" FontSize="16" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>

            <!-- Status Header and Detail -->
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="StatusTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{services:Localize Key=Tracker_OperationInProgress}" />
                <TextBlock x:Name="StatusDetail" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Percentage Counter -->
            <TextBlock x:Name="PercentageText" Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="8,0" />

            <!-- Buttons -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="CancelOperationButton" Click="OnCancelOperationClick" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Cancel" />
                        <TextBlock Text="{services:Localize Key=Tracker_Cancel}" />
                    </StackPanel>
                </Button>
                <Button x:Name="ViewActivityButton" Click="OnViewActivityClick" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="List" />
                        <TextBlock Text="{services:Localize Key=Tracker_ViewActivity}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Progress Bar -->
            <ProgressBar x:Name="OperationProgressBar" Grid.Row="1" Grid.ColumnSpan="4" Height="3" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
