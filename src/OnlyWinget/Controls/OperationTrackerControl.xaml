<UserControl
    x:Class="OnlyWinget.Controls.OperationTrackerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:OnlyWinget.Services">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="TrackerCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12,8" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="TrackerRoot" Style="{StaticResource TrackerCardStyle}" Margin="0,0,0,8" Visibility="Collapsed">
        <Grid ColumnSpacing="12" RowSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Status icon (progress is shown by the horizontal bar only) -->
            <FontIcon x:Name="StatusIcon" Grid.Column="0" Glyph="&#xE895;" FontSize="16" VerticalAlignment="Center" />

            <!-- Status Header and Detail -->
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="StatusTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{services:Localize Key=Tracker_OperationInProgress}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="StatusDetail" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Percentage Counter -->
            <TextBlock x:Name="PercentageText" Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Margin="8,0" />

            <!-- Buttons -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="DismissButton" Click="OnDismissClick" Visibility="Collapsed" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" AutomationProperties.AutomationId="TrackerDismissButton">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Accept" />
                        <TextBlock Text="{services:Localize Key=Tracker_Dismiss}" />
                    </StackPanel>
                </Button>
                <Button x:Name="CancelOperationButton" Click="OnCancelOperationClick" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Cancel" />
                        <TextBlock Text="{services:Localize Key=Tracker_Cancel}" />
                    </StackPanel>
                </Button>
                <Button x:Name="ViewActivityButton" Click="OnViewActivityClick" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="List" />
                        <TextBlock Text="{services:Localize Key=Tracker_ViewActivity}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Progress Bar -->
            <ProgressBar x:Name="OperationProgressBar" Grid.Row="1" Grid.ColumnSpan="4" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" AutomationProperties.Name="{services:Localize Key=Tracker_OperationInProgress}" />
        </Grid>
    </Border>
</UserControl>
