<ContentDialog
    x:Class="OnlyWinget.Controls.LogViewerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appSystem="using:OnlyWinget.Application.System"
    xmlns:local="using:OnlyWinget.Controls"
    xmlns:services="using:OnlyWinget.Services"
    Title="{services:Localize Key=Logs_Title}"
    CloseButtonText="{services:Localize Key=Logs_Close}"
    DefaultButton="Close"
    FullSizeDesired="False"
    MinWidth="720"
    MinHeight="480">

    <Grid RowSpacing="12" Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filters & Action Bar -->
        <Grid ColumnSpacing="8" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="LevelFilterCombo" SelectionChanged="OnFilterChanged" SelectedIndex="0" MinWidth="130" AutomationProperties.AutomationId="LogViewerLevelFilterCombo" AutomationProperties.Name="{services:Localize Key=Logs_LevelFilterName}">
                <ComboBoxItem Content="{services:Localize Key=Logs_AllLevels}" />
                <ComboBoxItem Content="{services:Localize Key=Logs_Level_Information}" />
                <ComboBoxItem Content="{services:Localize Key=Logs_Level_Warning}" />
                <ComboBoxItem Content="{services:Localize Key=Logs_Level_Error}" />
            </ComboBox>

            <TextBox
                x:Name="SearchBox"
                Grid.Column="1"
                PlaceholderText="{services:Localize Key=Logs_SearchPlaceholder}"
                AutomationProperties.AutomationId="LogViewerSearchBox"
                AutomationProperties.Name="{services:Localize Key=Logs_SearchName}"
                TextChanged="OnFilterChanged" />

            <Button
                Grid.Column="2"
                Click="OnExportClicked"
                AutomationProperties.AutomationId="LogViewerExportButton"
                AutomationProperties.Name="{services:Localize Key=Logs_ExportName}"
                Style="{StaticResource SecondaryButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                    <TextBlock Text="{services:Localize Key=Logs_Export}" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="3"
                Click="OnCopyClicked"
                AutomationProperties.AutomationId="LogViewerCopyButton"
                AutomationProperties.Name="{services:Localize Key=Logs_CopyName}"
                Style="{StaticResource SecondaryButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                    <TextBlock Text="{services:Localize Key=Logs_Copy}" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="4"
                Click="OnClearClicked"
                AutomationProperties.AutomationId="LogViewerClearButton"
                AutomationProperties.Name="{services:Localize Key=Logs_ClearName}"
                Style="{StaticResource SecondaryButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    <TextBlock Text="{services:Localize Key=Command_Clear}" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar x:Name="ClearConfirmation" Grid.Row="1" IsOpen="False" IsClosable="False" Severity="Warning"
                 Title="{services:Localize Key=Logs_ClearConfirm_Title}" Message="{services:Localize Key=Logs_ClearConfirm_Message}"
                 AutomationProperties.AutomationId="LogViewerClearConfirmation">
            <InfoBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{services:Localize Key=Command_Clear}" Click="OnConfirmClearClicked"
                            AutomationProperties.AutomationId="LogViewerConfirmClearButton" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="{services:Localize Key=Command_Cancel}" Click="OnCancelClearClicked"
                            AutomationProperties.AutomationId="LogViewerCancelClearButton" Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>

        <!-- Log Entry List -->
        <ListView
            x:Name="LogListView"
            Grid.Row="2"
            SelectionMode="Single"
            MinHeight="300"
            MaxHeight="500"
            AutomationProperties.AutomationId="LogViewerListView"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="appSystem:AppLogEntry">
                    <Grid ColumnSpacing="12" Padding="8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="{x:Bind FormattedTimestamp, Mode=OneTime}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />

                        <Border
                            Grid.Column="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}"
                            Padding="8,2"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="{x:Bind local:LogViewerDialog.GetLevelLabel(Level), Mode=OneTime}"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                FontWeight="SemiBold" />
                        </Border>

                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind Caller, Mode=OneTime}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Grid.Column="3"
                            Text="{x:Bind Message, Mode=OneTime}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True"
                            VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Status Summary Footer -->
        <TextBlock
            x:Name="StatusFooter"
            Grid.Row="3"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            HorizontalAlignment="Left" />
    </Grid>
</ContentDialog>
