<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="AddButtonContentTemplate"><StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlSpacing}"><SymbolIcon Symbol="Add" /><TextBlock Text="{Binding}" /></StackPanel></DataTemplate>
    <DataTemplate x:Key="EditButtonContentTemplate"><StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlSpacing}"><SymbolIcon Symbol="Edit" /><TextBlock Text="{Binding}" /></StackPanel></DataTemplate>
    <DataTemplate x:Key="DeleteButtonContentTemplate"><StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlSpacing}"><SymbolIcon Symbol="Delete" /><TextBlock Text="{Binding}" /></StackPanel></DataTemplate>
    <DataTemplate x:Key="SaveButtonContentTemplate"><StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlSpacing}"><SymbolIcon Symbol="Save" /><TextBlock Text="{Binding}" /></StackPanel></DataTemplate>
    <DataTemplate x:Key="RefreshButtonContentTemplate"><StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlSpacing}"><SymbolIcon Symbol="Refresh" /><TextBlock Text="{Binding}" /></StackPanel></DataTemplate>
    <DataTemplate x:Key="SearchButtonContentTemplate"><StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlSpacing}"><SymbolIcon Symbol="Find" /><TextBlock Text="{Binding}" /></StackPanel></DataTemplate>
    <DataTemplate x:Key="DownloadButtonContentTemplate"><StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlSpacing}"><SymbolIcon Symbol="Download" /><TextBlock Text="{Binding}" /></StackPanel></DataTemplate>
    <DataTemplate x:Key="CancelButtonContentTemplate"><StackPanel Orientation="Horizontal" Spacing="{StaticResource ControlSpacing}"><SymbolIcon Symbol="Cancel" /><TextBlock Text="{Binding}" /></StackPanel></DataTemplate>
    <Style x:Key="ActionBarStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="{StaticResource ControlSpacing}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}"><Setter Property="MinWidth" Value="112" /><Setter Property="HorizontalAlignment" Value="Left" /></Style>
    <Style x:Key="SecondaryButtonStyle" TargetType="Button"><Setter Property="MinWidth" Value="104" /><Setter Property="HorizontalAlignment" Value="Left" /></Style>
    <Style x:Key="DestructiveButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" /></Style>
    <Style x:Key="AddPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"><Setter Property="ContentTemplate" Value="{StaticResource AddButtonContentTemplate}" /></Style>
    <Style x:Key="EditButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="ContentTemplate" Value="{StaticResource EditButtonContentTemplate}" /></Style>
    <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource DestructiveButtonStyle}"><Setter Property="ContentTemplate" Value="{StaticResource DeleteButtonContentTemplate}" /></Style>
    <Style x:Key="SaveButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="ContentTemplate" Value="{StaticResource SaveButtonContentTemplate}" /></Style>
    <Style x:Key="RefreshButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="ContentTemplate" Value="{StaticResource RefreshButtonContentTemplate}" /></Style>
    <Style x:Key="SearchPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"><Setter Property="ContentTemplate" Value="{StaticResource SearchButtonContentTemplate}" /></Style>
    <Style x:Key="DownloadPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"><Setter Property="ContentTemplate" Value="{StaticResource DownloadButtonContentTemplate}" /></Style>
    <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="ContentTemplate" Value="{StaticResource CancelButtonContentTemplate}" /></Style>
</ResourceDictionary>
