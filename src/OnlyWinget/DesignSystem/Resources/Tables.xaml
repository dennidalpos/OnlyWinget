<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OnlyWinget.Controls">
    <controls:TableColumnLayout x:Key="UpdatesColumnLayout" />
    <controls:FixedTableLayout x:Key="SearchColumnLayout" Column0Width="44" Column1Width="190" Column2Width="230" Column3Width="100" Column4Width="100" Column5Width="120" Column6Width="170" />
    <controls:FixedTableLayout x:Key="PresetColumnLayout" Column0Width="44" Column1Width="180" Column2Width="240" Column3Width="120" Column4Width="110" Column5Width="120" />
    <controls:FixedTableLayout x:Key="WindowsUpdateColumnLayout" Column0Width="44" Column1Width="280" Column2Width="100" Column3Width="100" Column4Width="150" Column5Width="90" Column6Width="90" Column7Width="90" Column8Width="80" Column9Width="150" />
    <Style x:Key="TableHeaderTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="TableCellTextBlockStyle" TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ListRowContainerStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{StaticResource TableCellPadding}" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinHeight" Value="42" />
    </Style>
    <Style x:Key="TableRowContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource ListRowContainerStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="MinHeight" Value="{StaticResource TableRowMinHeight}" />
    </Style>
    <Style x:Key="TableHeaderSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style x:Key="TableCellDividerStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style x:Key="TableRowDividerStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
</ResourceDictionary>
