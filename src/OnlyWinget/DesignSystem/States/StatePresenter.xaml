<UserControl
    x:Class="OnlyWinget.DesignSystem.States.StatePresenter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:OnlyWinget.Presentation">
    <Grid Visibility="{x:Bind CardVisibility, Mode=OneWay}" Margin="0,0,0,12">
        <Border Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="16" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Icon/Progress Ring -->
                <Grid Grid.Column="0" Grid.Row="0" Grid.RowSpan="4" VerticalAlignment="Top" Margin="0,4,0,0">
                    <ProgressRing Width="24" Height="24" IsActive="{x:Bind IsLoading, Mode=OneWay}" Visibility="{x:Bind ProgressRingVisibility, Mode=OneWay}" />
                    <FontIcon Glyph="{x:Bind IconGlyph, Mode=OneWay}" Foreground="{x:Bind IconForeground, Mode=OneWay}" FontSize="24" Visibility="{x:Bind FontIconVisibility, Mode=OneWay}" />
                </Grid>

                <!-- Title & Message -->
                <StackPanel Grid.Column="1" Grid.Row="0" Spacing="4">
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" Visibility="{x:Bind TitleVisibility, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Message, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Progress Bar -->
                <Grid Grid.Column="1" Grid.Row="1" Visibility="{x:Bind ProgressBarVisibility, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="480" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}" Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                </Grid>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ActionsVisibility, Mode=OneWay}">
                    <Button x:Name="ActionButton" Visibility="{x:Bind ActionButtonVisibility, Mode=OneWay}" Click="OnAction" Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="CancelButton" Visibility="{x:Bind CancelButtonVisibility, Mode=OneWay}" Click="OnCancel" />
                </StackPanel>

                <!-- Details -->
                <Expander x:Name="DetailsExpander" Grid.Column="1" Grid.Row="3" Visibility="{x:Bind DetailsVisibility, Mode=OneWay}" HorizontalAlignment="Stretch">
                    <TextBlock Text="{x:Bind Details, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                </Expander>
            </Grid>
        </Border>
    </Grid>
</UserControl>
