<UserControl
    x:Class="OnlyWinget.DesignSystem.States.StatePresenter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <InfoBar
        x:Name="Bar"
        IsOpen="{x:Bind IsOpen, Mode=OneWay}"
        IsClosable="False"
        Severity="{x:Bind Severity, Mode=OneWay}"
        Title="{x:Bind Title, Mode=OneWay}"
        Message="{x:Bind Message, Mode=OneWay}"
        AutomationProperties.LiveSetting="Polite">
        <InfoBar.Content>
            <StackPanel Spacing="8">
                <ProgressRing Width="20" Height="20" IsActive="{x:Bind IsLoading, Mode=OneWay}" HorizontalAlignment="Left" />
                <Expander x:Name="DetailsExpander" Header="Details" Visibility="{x:Bind DetailsVisibility, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Details, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                </Expander>
            </StackPanel>
        </InfoBar.Content>
    </InfoBar>
</UserControl>
