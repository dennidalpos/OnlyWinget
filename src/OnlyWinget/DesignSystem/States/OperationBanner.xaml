<UserControl
    x:Class="OnlyWinget.DesignSystem.States.OperationBanner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <InfoBar x:Name="Bar" IsOpen="{x:Bind IsOpen}" IsClosable="False" Severity="{x:Bind Severity}" Title="{x:Bind Title}" Message="{x:Bind Message}" AutomationProperties.LiveSetting="Polite">
        <InfoBar.Content>
            <StackPanel Spacing="8">
                <ProgressBar IsIndeterminate="{x:Bind IsIndeterminate}" Value="{x:Bind Progress}" Maximum="100" HorizontalAlignment="Stretch" MaxWidth="480" />
                <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <Button x:Name="CancelButton" Content="Cancel" Visibility="{x:Bind CancelVisibility}" Click="OnCancel" HorizontalAlignment="Left" />
            </StackPanel>
        </InfoBar.Content>
    </InfoBar>
</UserControl>
