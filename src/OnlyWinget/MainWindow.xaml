<Window
    x:Class="OnlyWinget.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OnlyWinget.Controls"
    Title="OnlyWinget">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="AppTitleBar" Height="44" Background="Transparent" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="Assets/OnlyWinget-icon.png" Width="16" Height="16" Margin="0,0,8,0" />
                <TextBlock Text="OnlyWinget" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            Grid.Row="1"
            x:Name="RootNavigation"
            CompactModeThresholdWidth="720"
            ExpandedModeThresholdWidth="1100"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneTitle=""
            PaneDisplayMode="Auto"
            AutomationProperties.AutomationId="RootNavigation"
            SelectionFollowsFocus="Enabled"
            ItemInvoked="OnItemInvoked"
            SelectionChanged="OnSelectionChanged"
            PaneClosing="OnPaneClosing"
            PaneOpened="OnPaneOpened"
            PaneClosed="OnPaneClosed"
            DisplayModeChanged="OnDisplayModeChanged">
            <NavigationView.PaneFooter>
                <StackPanel Orientation="Vertical" Spacing="4" Margin="0,0,0,12">
                    <NavigationViewItem x:Name="PinMenuItem" Tapped="OnPinMenuTapped">
                        <NavigationViewItem.Icon>
                            <FontIcon x:Name="PinMenuIcon" Glyph="&#xE718;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="OpenLogsItem" Tapped="OnOpenLogsTapped">
                        <NavigationViewItem.Icon>
                            <SymbolIcon Symbol="Document" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </StackPanel>
            </NavigationView.PaneFooter>
            <ScrollViewer
                x:Name="MainPageScrollViewer"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollMode="Enabled"
                SizeChanged="OnMainPageScrollViewerSizeChanged"
                BringIntoViewRequested="OnMainPageScrollViewerBringIntoViewRequested">
                <ContentControl
                    x:Name="PageHost"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
            </ScrollViewer>
        </NavigationView>

        <!-- Resizer Bar Overlay -->
        <controls:CursorGrid
            x:Name="PaneResizer"
            Grid.Row="1"
            Width="8"
            HorizontalAlignment="Left"
            Background="Transparent"
            Visibility="Collapsed"
            PointerPressed="OnResizerPointerPressed"
            PointerMoved="OnResizerPointerMoved"
            PointerReleased="OnResizerPointerReleased"
            PointerEntered="OnResizerPointerEntered"
            PointerExited="OnResizerPointerExited">
            <Border x:Name="ResizerVisualLine" Width="2" HorizontalAlignment="Center" Background="{ThemeResource SystemControlBackgroundListLowBrush}" Opacity="0" />
        </controls:CursorGrid>
    </Grid>
</Window>
