<Window
    x:Class="OnlyWinget.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OnlyWinget">
    <NavigationView
        x:Name="RootNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Left"
        SelectionChanged="OnSelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Dashboard" Icon="Home" Tag="dashboard" />
            <NavigationViewItem Content="Presets" Icon="Library" Tag="presets" />
            <NavigationViewItem Content="Search" Icon="Find" Tag="search" />
            <NavigationViewItem Content="Updates" Icon="Sync" Tag="updates" />
            <NavigationViewItem Content="Sources" Icon="Globe" Tag="sources" />
            <NavigationViewItem Content="Activity" Icon="Clock" Tag="activity" />
        </NavigationView.MenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
