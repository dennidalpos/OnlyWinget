<Window x:Class="OnlyWinget.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:helpers="clr-namespace:OnlyWinget.Helpers"
        Title="{Binding Strings.Title}"
        Icon="Assets/OnlyWinget.ico"
        Height="{StaticResource MainWindowHeight}"
        Width="{StaticResource MainWindowWidth}"
        MinHeight="{StaticResource MainWindowMinHeight}"
        MinWidth="{StaticResource MainWindowMinWidth}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}"
        StateChanged="OnWindowStateChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        CornerRadius="0"
                        GlassFrameThickness="0"
                        ResizeBorderThickness="6"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Border Margin="{StaticResource WindowFrameMargin}"
          Background="{StaticResource WindowBackgroundBrush}"
          BorderBrush="{StaticResource BorderStrongBrush}"
          BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <Border Grid.Row="0"
              Background="{StaticResource ChromeBackgroundBrush}"
              BorderBrush="{StaticResource ChromeBorderBrush}"
              BorderThickness="0,0,0,1"
              MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
        <Grid Margin="{StaticResource ChromeTitleBarContentMargin}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Image Grid.Column="0"
                 Width="{StaticResource ChromeIconSize}"
                 Height="{StaticResource ChromeIconSize}"
                 Margin="{StaticResource ChromeIconMargin}"
                 Source="Assets/OnlyWinget-icon.png"
                 VerticalAlignment="Center"/>

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      VerticalAlignment="Center">
            <TextBlock FontSize="{StaticResource FontSizeXl}"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource ChromeTextBrush}"
                       VerticalAlignment="Center"
                       Text="{Binding Strings.ProductName}"/>
            <!-- Permission badge: only shown when the app is running as administrator. -->
            <Border Margin="{StaticResource ChromeBadgeMargin}"
                    VerticalAlignment="Center"
                    Style="{StaticResource WarningBadgeBorderStyle}"
                    Visibility="{Binding IsRunningAsAdministrator, Converter={StaticResource BoolToVisibility}}">
              <TextBlock FontSize="{StaticResource FontSizeXs}"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource WarningTextBrush}"
                         Text="{Binding PermissionStatusBadgeText}"/>
            </Border>
          </StackPanel>

          <Border Grid.Column="2"
                  Margin="{StaticResource ChromeStatusMargin}"
                  Style="{StaticResource ChromeStatusBadgeBorderStyle}"
                  VerticalAlignment="Center">
            <TextBlock Style="{StaticResource ChromeStatusBadgeTextStyle}"
                       Text="{Binding HeaderStatusText}"/>
          </Border>

          <StackPanel Grid.Column="3"
                      Orientation="Horizontal"
                      VerticalAlignment="Center"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource WindowCommandButtonStyle}"
                    AutomationProperties.Name="{Binding Strings.MinimizeWindowTooltip}"
                    ToolTip="{Binding Strings.MinimizeWindowTooltip}"
                    Click="OnMinimizeClick">
              <TextBlock FontFamily="{StaticResource IconFontFamily}"
                         FontSize="{StaticResource FontSizeMd}"
                         Text="&#xE921;"/>
            </Button>
            <Button x:Name="MaximizeRestoreButton"
                    Style="{StaticResource WindowCommandButtonStyle}"
                    AutomationProperties.Name="{Binding Strings.MaximizeWindowTooltip}"
                    ToolTip="{Binding Strings.MaximizeWindowTooltip}"
                    Click="OnMaximizeRestoreClick">
              <TextBlock x:Name="MaximizeRestoreGlyph"
                         FontFamily="{StaticResource IconFontFamily}"
                         FontSize="{StaticResource FontSizeMd}"
                         Text="&#xE922;"/>
            </Button>
            <Button Style="{StaticResource CloseWindowCommandButtonStyle}"
                    AutomationProperties.Name="{Binding Strings.CloseWindowTooltip}"
                    ToolTip="{Binding Strings.CloseWindowTooltip}"
                    Click="OnCloseClick">
              <TextBlock FontFamily="{StaticResource IconFontFamily}"
                         FontSize="{StaticResource FontSizeMd}"
                         Text="&#xE8BB;"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Main content -->
      <Grid Grid.Row="1" Margin="{StaticResource AppContentMargin}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220" MinWidth="160"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <GridSplitter Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{StaticResource TransparentBrush}"
                      Focusable="False"
                      IsTabStop="False"
                      Cursor="SizeWE"/>

        <!-- LEFT SIDEBAR -->
        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Inline preset header -->
          <Border Grid.Row="0" Style="{StaticResource SidebarHeaderBorderStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         FontSize="{StaticResource FontSizeLg}"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         Text="{Binding PresetWorkspace.CurrentPresetName}"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="1"
                         Margin="{StaticResource ChromeBadgeMargin}"
                         Style="{StaticResource CaptionTextStyle}"
                         VerticalAlignment="Center"
                         Text="{Binding PresetWorkspace.CurrentPresetAppCountText}"/>
            </Grid>
          </Border>

          <!-- Presets management card -->
          <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <ListBox Grid.Row="0"
                       ItemsSource="{Binding PresetWorkspace.TabNames}"
                       SelectedItem="{Binding PresetWorkspace.SelectedTabName}"
                       AutomationProperties.Name="{Binding Strings.PresetSelectorAutomationName}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding}"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <StackPanel Grid.Row="2">
                <Button Content="{Binding Strings.NewTab}"
                        Margin="{StaticResource StackItemSpacing6}"
                        Command="{Binding PresetWorkspace.NewTabCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="{Binding Strings.RenameTab}"
                        Margin="{StaticResource StackItemSpacing6}"
                        Command="{Binding PresetWorkspace.RenameTabCommand}"
                        Style="{StaticResource NeutralButtonStyle}"/>
                <UniformGrid Columns="2" Rows="1">
                  <Button Content="{Binding Strings.Import}"
                          Margin="{StaticResource ButtonInlineSpacing}"
                          Command="{Binding PresetWorkspace.ImportPresetCommand}"
                          ToolTip="{Binding Strings.ImportPresetTooltip}"
                          Style="{StaticResource NeutralButtonStyle}"/>
                  <Button Content="{Binding Strings.Export}"
                          Command="{Binding PresetWorkspace.ExportPresetCommand}"
                          ToolTip="{Binding Strings.ExportPresetTooltip}"
                          Style="{StaticResource NeutralButtonStyle}"/>
                </UniformGrid>
              </StackPanel>

              <Button Grid.Row="4"
                      Content="{Binding Strings.DeleteTab}"
                      Command="{Binding PresetWorkspace.DeleteTabCommand}"
                      Style="{StaticResource DangerButtonStyle}"/>
            </Grid>
          </Border>
        </Grid>

        <!-- CENTER CONTENT -->
        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="220" MinHeight="120"/>
          </Grid.RowDefinitions>

          <!-- Unified toolbar -->
          <Border Grid.Row="0" Style="{StaticResource ToolbarBorderStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0"
                         FontSize="{StaticResource FontSizeTitle}"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         Text="{Binding CurrentWorkspaceTitle}"/>

              <StackPanel Grid.Row="1"
                          Margin="{StaticResource TopSpacing6}">
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsPresetWorkspaceVisible, Converter={StaticResource BoolToVisibility}}">
                  <Button Content="{Binding Strings.Add}"
                          Margin="{StaticResource ButtonInlineSpacing}"
                          Command="{Binding PresetWorkspace.AddCommand}"
                          Style="{StaticResource PrimaryButtonStyle}"/>
                  <Button Content="{Binding Strings.Edit}"
                          Margin="{StaticResource ButtonInlineSpacing}"
                          Command="{Binding PresetWorkspace.EditCommand}"
                          Style="{StaticResource NeutralButtonStyle}"/>
                  <Button Content="{Binding Strings.Remove}"
                          Command="{Binding PresetWorkspace.RemoveCommand}"
                          Style="{StaticResource DangerButtonStyle}"/>
                </StackPanel>

                <StackPanel Margin="{StaticResource TopSpacing6}"
                            Orientation="Horizontal">
                  <Button x:Name="SearchWorkspaceButton"
                          Content="{Binding Strings.Search}"
                          Margin="{StaticResource ButtonInlineSpacing}"
                          Command="{Binding OpenSearchCommand}"
                          ToolTip="{Binding Strings.SearchTooltip}"
                          Style="{StaticResource PrimaryButtonStyle}"
                          Visibility="{Binding IsSearchWorkspaceButtonVisible, Converter={StaticResource BoolToVisibility}}"/>
                  <Button x:Name="UpdatesWorkspaceButton"
                          Content="{Binding Strings.Updates}"
                          Margin="{StaticResource ButtonInlineSpacing}"
                          Command="{Binding OpenUpdatesCommand}"
                          ToolTip="{Binding Strings.UpdatesTooltip}"
                          Style="{StaticResource NeutralButtonStyle}"
                          Visibility="{Binding IsUpdatesWorkspaceButtonVisible, Converter={StaticResource BoolToVisibility}}"/>
                  <Button Content="{Binding Strings.Apply}"
                          Command="{Binding ApplyCommand}"
                          IsEnabled="{Binding IsApplyEnabled}"
                          ToolTip="{Binding Strings.ApplyTooltip}"
                          Style="{StaticResource SuccessButtonStyle}"/>
                </StackPanel>

                <StackPanel Margin="{StaticResource TopSpacing6}"
                            Orientation="Horizontal">
                  <Button Content="{Binding Strings.Save}"
                          Margin="{StaticResource ButtonInlineSpacing}"
                          Command="{Binding PresetWorkspace.SaveCommand}"
                          ToolTip="{Binding Strings.SaveTooltip}"
                          Style="{StaticResource NeutralButtonStyle}"/>
                  <TextBlock Margin="{StaticResource InlineItemSpacing6}"
                             VerticalAlignment="Center"
                             Style="{StaticResource CaptionTextStyle}"
                             Text="{Binding Strings.LanguageLabel}"/>
                  <ComboBox Width="118"
                            Height="{StaticResource ControlHeightMd}"
                            ItemsSource="{Binding AvailableLanguages}"
                            SelectedItem="{Binding SelectedLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            DisplayMemberPath="DisplayName"
                            ToolTip="{Binding Strings.LanguageSelectorTooltip}"
                            AutomationProperties.Name="{Binding Strings.LanguageSelectorAutomationName}"/>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Content card -->
          <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <Grid>

              <!-- PRESET WORKSPACE -->
              <Grid Visibility="{Binding IsPresetWorkspaceVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                  <ListView x:Name="PresetAppsList"
                            ItemsSource="{Binding PresetWorkspace.CurrentApps}"
                            SelectedItem="{Binding PresetWorkspace.SelectedApp}"
                            SelectionMode="Single"
                            IsEnabled="{Binding PresetWorkspace.AreActionsEnabled}"
                            PreviewKeyDown="OnListViewPreviewKeyDown"
                            helpers:GridViewAutoSizeBehavior.Enabled="True"
                            AutomationProperties.Name="{Binding Strings.AppListAutomationName}">
                    <ListView.View>
                      <GridView>
                        <GridViewColumn helpers:GridViewAutoSizeBehavior.StarWidth="1.15"
                                        helpers:GridViewAutoSizeBehavior.MinWidth="220"
                                        Header="{Binding DataContext.Strings.Name, RelativeSource={RelativeSource AncestorType=ListView}}">
                          <GridViewColumn.CellTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource TableCellBorderStyle}">
                                <TextBlock Style="{StaticResource TableCellTextStyle}"
                                           Text="{Binding Name}"/>
                              </Border>
                            </DataTemplate>
                          </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn helpers:GridViewAutoSizeBehavior.StarWidth="1.25"
                                        helpers:GridViewAutoSizeBehavior.MinWidth="240"
                                        Header="{Binding DataContext.Strings.Id, RelativeSource={RelativeSource AncestorType=ListView}}">
                          <GridViewColumn.CellTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource TableCellBorderStyle}">
                                <TextBlock Style="{StaticResource TableCellTextStyle}"
                                           Text="{Binding Id}"/>
                              </Border>
                            </DataTemplate>
                          </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn helpers:GridViewAutoSizeBehavior.StarWidth="0.7"
                                        helpers:GridViewAutoSizeBehavior.MinWidth="120"
                                        Header="{Binding DataContext.Strings.PackageDialogArchitectureLabel, RelativeSource={RelativeSource AncestorType=ListView}}">
                          <GridViewColumn.CellTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource TableCellBorderStyle}">
                                <TextBlock Style="{StaticResource TableCellTextStyle}"
                                           Text="{Binding Architecture}"/>
                              </Border>
                            </DataTemplate>
                          </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="{StaticResource ActionColumnWidth}"
                                        Header="{Binding DataContext.Strings.Action, RelativeSource={RelativeSource AncestorType=ListView}}">
                          <GridViewColumn.CellTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource TableCellCompactBorderStyle}">
                                <ComboBox Width="{StaticResource ActionSelectorWidth}"
                                          Height="{StaticResource ControlHeightSm}"
                                          ItemsSource="{Binding DataContext.PresetWorkspace.AvailableActions, RelativeSource={RelativeSource AncestorType=ListView}}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.Name="{Binding DataContext.Strings.ActionSelectorAutomationName, RelativeSource={RelativeSource AncestorType=ListView}}">
                                  <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                      <TextBlock Text="{Binding Label}"
                                                 TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                  </ComboBox.ItemTemplate>
                                </ComboBox>
                              </Border>
                            </DataTemplate>
                          </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="{StaticResource StatusColumnWidth}"
                                        Header="{Binding DataContext.Strings.Status, RelativeSource={RelativeSource AncestorType=ListView}}">
                          <GridViewColumn.CellTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource TableCellCompactBorderStyle}">
                                <Border Tag="{Binding StatusBadgeKey}"
                                        Style="{StaticResource StatusBadgeBorderStyle}">
                                  <TextBlock Style="{StaticResource StatusBadgeTextStyle}"
                                             Text="{Binding Status}"/>
                                </Border>
                              </Border>
                            </DataTemplate>
                          </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn helpers:GridViewAutoSizeBehavior.StarWidth="1"
                                        helpers:GridViewAutoSizeBehavior.MinWidth="200"
                                        Header="{Binding DataContext.Strings.ErrorHeader, RelativeSource={RelativeSource AncestorType=ListView}}">
                          <GridViewColumn.CellTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource TableCellBorderStyle}">
                                <TextBlock Style="{StaticResource TableCellTextStyle}"
                                           Text="{Binding ErrorMessage}"
                                           ToolTip="{Binding ErrorMessage}"/>
                              </Border>
                            </DataTemplate>
                          </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn helpers:GridViewAutoSizeBehavior.StarWidth="1"
                                        helpers:GridViewAutoSizeBehavior.MinWidth="200"
                                        Header="{Binding DataContext.Strings.ResolutionHeader, RelativeSource={RelativeSource AncestorType=ListView}}">
                          <GridViewColumn.CellTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource TableCellBorderStyle}">
                                <TextBlock Style="{StaticResource TableCellTextStyle}"
                                           Text="{Binding Resolution}"
                                           ToolTip="{Binding Resolution}"/>
                              </Border>
                            </DataTemplate>
                          </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                      </GridView>
                    </ListView.View>
                  </ListView>

                  <Border>
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource EmptyStateBorderStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding PresetWorkspace.CurrentApps.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel>
                      <TextBlock HorizontalAlignment="Center"
                                 Style="{StaticResource SectionTitleTextStyle}"
                                 Text="{Binding Strings.AppListEmptyTitle}"/>
                      <TextBlock Margin="{StaticResource TopSpacing6}"
                                 HorizontalAlignment="Center"
                                 TextAlignment="Center"
                                 Style="{StaticResource SectionBodyTextStyle}"
                                 Text="{Binding Strings.AppListEmptyBody}"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </Grid>

              <!-- SEARCH WORKSPACE -->
              <Grid Visibility="{Binding IsSearchVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="10"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="10"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid Grid.Column="0">
                    <TextBox x:Name="SearchQueryBox"
                             Height="{StaticResource ControlHeightLg}"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{Binding Strings.SearchQueryAutomationName}">
                      <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding RunSearchCommand}"/>
                      </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock IsHitTestVisible="False"
                               Text="{Binding Strings.SearchHintText}"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="13,0,0,0"
                               VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding SearchQuery}" Value="">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                  <Button Grid.Column="2"
                          Content="{Binding Strings.Search}"
                          MinWidth="{StaticResource ButtonMinWidth}"
                          Height="{StaticResource ControlHeightLg}"
                          Command="{Binding RunSearchCommand}"
                          IsEnabled="{Binding IsSearchEnabled}"
                          Style="{StaticResource PrimaryButtonStyle}"/>
                  <Button Grid.Column="4"
                          Content="{Binding Strings.CloseButton}"
                          MinWidth="{StaticResource ButtonMinWidth}"
                          Height="{StaticResource ControlHeightLg}"
                          Command="{Binding CloseSearchCommand}"
                          Style="{StaticResource NeutralButtonStyle}"/>
                </Grid>

                <Grid Grid.Row="2">
                  <ListView x:Name="SearchResultsList"
                            ItemsSource="{Binding SearchResults}"
                            SelectedItem="{Binding SelectedSearchResult}"
                            SelectionMode="Extended"
                            SelectionChanged="OnSearchSelectionChanged"
                            helpers:GridViewAutoSizeBehavior.Enabled="True"
                            AutomationProperties.Name="{Binding Strings.SearchResultsAutomationName}">
                    <ListView.View>
                      <GridView>
                        <GridViewColumn helpers:GridViewAutoSizeBehavior.StarWidth="1.35"
                                        helpers:GridViewAutoSizeBehavior.MinWidth="320"
                                        Header="{Binding DataContext.Strings.Name, RelativeSource={RelativeSource AncestorType=ListView}}">
                          <GridViewColumn.CellTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource TableCellBorderStyle}">
                                <TextBlock Style="{StaticResource TableCellTextStyle}"
                                           Text="{Binding Name}"/>
                              </Border>
                            </DataTemplate>
                          </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn helpers:GridViewAutoSizeBehavior.StarWidth="1.55"
                                        helpers:GridViewAutoSizeBehavior.MinWidth="360"
                                        Header="{Binding DataContext.Strings.Id, RelativeSource={RelativeSource AncestorType=ListView}}">
                          <GridViewColumn.CellTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource TableCellBorderStyle}">
                                <TextBlock Style="{StaticResource TableCellTextStyle}"
                                           Text="{Binding Id}"/>
                              </Border>
                            </DataTemplate>
                          </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn helpers:GridViewAutoSizeBehavior.StarWidth="0.75"
                                        helpers:GridViewAutoSizeBehavior.MinWidth="180"
                                        Header="{Binding DataContext.Strings.VersionHeader, RelativeSource={RelativeSource AncestorType=ListView}}">
                          <GridViewColumn.CellTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource TableCellBorderStyle}">
                                <TextBlock Style="{StaticResource TableCellTextStyle}"
                                           Text="{Binding Version}"/>
                              </Border>
                            </DataTemplate>
                          </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                      </GridView>
                    </ListView.View>
                  </ListView>

                  <Border>
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource LoadingStateBorderStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSearchInProgress}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel>
                      <TextBlock HorizontalAlignment="Center"
                                 Style="{StaticResource SectionTitleTextStyle}"
                                 Text="{Binding Strings.SearchLoadingTitle}"/>
                      <TextBlock Margin="{StaticResource TopSpacing6}"
                                 HorizontalAlignment="Center"
                                 TextAlignment="Center"
                                 Style="{StaticResource SectionBodyTextStyle}"
                                 Text="{Binding Strings.SearchLoadingBody}"/>
                      <ProgressBar Margin="{StaticResource TopSpacing12}"
                                   IsIndeterminate="True"/>
                    </StackPanel>
                  </Border>

                  <Border>
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource EmptyStateBorderStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsSearchEmptyStateVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel>
                      <TextBlock HorizontalAlignment="Center"
                                 Style="{StaticResource SectionTitleTextStyle}"
                                 Text="{Binding Strings.SearchEmptyTitle}"/>
                      <TextBlock Margin="{StaticResource TopSpacing6}"
                                 HorizontalAlignment="Center"
                                 TextAlignment="Center"
                                 Style="{StaticResource SectionBodyTextStyle}"
                                 Text="{Binding Strings.SearchEmptyBody}"/>
                    </StackPanel>
                  </Border>
                </Grid>

                <StackPanel Grid.Row="4">
                  <TextBlock Style="{StaticResource CaptionTextStyle}"
                             Text="{Binding Strings.Id}"
                             Margin="0,0,0,4"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchPickId, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{Binding Strings.SearchSelectedIdAutomationName}"/>
                    <Button Grid.Column="2"
                            Content="{Binding SearchAddButtonText}"
                            MinWidth="{StaticResource DialogPrimaryButtonMinWidth}"
                            Command="{Binding UseSearchIdCommand}"
                            Style="{StaticResource SuccessButtonStyle}"/>
                  </Grid>
                </StackPanel>
              </Grid>

              <!-- UPDATES WORKSPACE -->
              <Grid Visibility="{Binding IsUpdatesVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="10"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                  <ListView x:Name="UpdatesList"
                            ItemsSource="{Binding Updates}"
                            SelectionMode="Single"
                            PreviewKeyDown="OnListViewPreviewKeyDown"
                            helpers:GridViewAutoSizeBehavior.Enabled="True"
                            AutomationProperties.Name="{Binding Strings.UpdatesListAutomationName}">
                    <ListView.View>
                      <GridView>
                        <GridViewColumn Width="40" Header="">
                          <GridViewColumn.CellTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource TableCellCompactBorderStyle}">
                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}"
                                          HorizontalAlignment="Center"
                                          AutomationProperties.Name="{Binding DataContext.Strings.SelectUpdateAutomationName, RelativeSource={RelativeSource AncestorType=ListView}}"/>
                              </Border>
                            </DataTemplate>
                          </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn helpers:GridViewAutoSizeBehavior.StarWidth="1.3"
                                        helpers:GridViewAutoSizeBehavior.MinWidth="280"
                                        Header="{Binding DataContext.Strings.Name, RelativeSource={RelativeSource AncestorType=ListView}}">
                          <GridViewColumn.CellTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource TableCellBorderStyle}">
                                <TextBlock Style="{StaticResource TableCellTextStyle}"
                                           Text="{Binding Name}"/>
                              </Border>
                            </DataTemplate>
                          </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn helpers:GridViewAutoSizeBehavior.StarWidth="1.7"
                                        helpers:GridViewAutoSizeBehavior.MinWidth="360"
                                        Header="{Binding DataContext.Strings.Id, RelativeSource={RelativeSource AncestorType=ListView}}">
                          <GridViewColumn.CellTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource TableCellBorderStyle}">
                                <TextBlock Style="{StaticResource TableCellTextStyle}"
                                           Text="{Binding Id}"/>
                              </Border>
                            </DataTemplate>
                          </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn helpers:GridViewAutoSizeBehavior.MinWidth="150"
                                        Width="150"
                                        Header="{Binding DataContext.Strings.VersionHeader, RelativeSource={RelativeSource AncestorType=ListView}}">
                          <GridViewColumn.CellTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource TableCellBorderStyle}">
                                <TextBlock Style="{StaticResource TableCellTextStyle}"
                                           Text="{Binding Version}"/>
                              </Border>
                            </DataTemplate>
                          </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn helpers:GridViewAutoSizeBehavior.MinWidth="150"
                                        Width="150"
                                        Header="{Binding DataContext.Strings.AvailableHeader, RelativeSource={RelativeSource AncestorType=ListView}}">
                          <GridViewColumn.CellTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource TableCellBorderStyle}">
                                <TextBlock Style="{StaticResource TableCellTextStyle}"
                                           Text="{Binding Available}"/>
                              </Border>
                            </DataTemplate>
                          </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="{StaticResource StatusColumnWidth}"
                                        Header="{Binding DataContext.Strings.Status, RelativeSource={RelativeSource AncestorType=ListView}}">
                          <GridViewColumn.CellTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource TableCellCompactBorderStyle}">
                                <Border Tag="{Binding StatusBadgeKey}"
                                        Style="{StaticResource StatusBadgeBorderStyle}">
                                  <TextBlock Style="{StaticResource StatusBadgeTextStyle}"
                                             Text="{Binding Status}"/>
                                </Border>
                              </Border>
                            </DataTemplate>
                          </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn helpers:GridViewAutoSizeBehavior.StarWidth="1"
                                        helpers:GridViewAutoSizeBehavior.MinWidth="240"
                                        Header="{Binding DataContext.Strings.ErrorHeader, RelativeSource={RelativeSource AncestorType=ListView}}">
                          <GridViewColumn.CellTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource TableCellBorderStyle}">
                                <TextBlock Style="{StaticResource TableCellTextStyle}"
                                           Text="{Binding ErrorMessage}"
                                           ToolTip="{Binding ErrorMessage}"/>
                              </Border>
                            </DataTemplate>
                          </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn helpers:GridViewAutoSizeBehavior.StarWidth="1"
                                        helpers:GridViewAutoSizeBehavior.MinWidth="240"
                                        Header="{Binding DataContext.Strings.ResolutionHeader, RelativeSource={RelativeSource AncestorType=ListView}}">
                          <GridViewColumn.CellTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource TableCellBorderStyle}">
                                <TextBlock Style="{StaticResource TableCellTextStyle}"
                                           Text="{Binding Resolution}"
                                           ToolTip="{Binding Resolution}"/>
                              </Border>
                            </DataTemplate>
                          </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                      </GridView>
                    </ListView.View>
                  </ListView>

                  <Border>
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource LoadingStateBorderStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsUpdatesLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel>
                      <TextBlock HorizontalAlignment="Center"
                                 Style="{StaticResource SectionTitleTextStyle}"
                                 Text="{Binding Strings.UpdatesLoadingTitle}"/>
                      <TextBlock Margin="{StaticResource TopSpacing6}"
                                 HorizontalAlignment="Center"
                                 TextAlignment="Center"
                                 Style="{StaticResource SectionBodyTextStyle}"
                                 Text="{Binding Strings.UpdatesLoadingBody}"/>
                      <ProgressBar Margin="{StaticResource TopSpacing12}"
                                   IsIndeterminate="True"/>
                    </StackPanel>
                  </Border>

                  <Border>
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource EmptyStateBorderStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsUpdatesEmptyStateVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel>
                      <TextBlock HorizontalAlignment="Center"
                                 Style="{StaticResource SectionTitleTextStyle}"
                                 Text="{Binding Strings.UpdatesEmptyTitle}"/>
                      <TextBlock Margin="{StaticResource TopSpacing6}"
                                 HorizontalAlignment="Center"
                                 TextAlignment="Center"
                                 Style="{StaticResource SectionBodyTextStyle}"
                                 Text="{Binding Strings.UpdatesEmptyBody}"/>
                    </StackPanel>
                  </Border>
                </Grid>

                <Grid Grid.Row="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="1"
                          Content="{Binding Strings.RefreshUpdates}"
                          MinWidth="{StaticResource DialogButtonMinWidth}"
                          Command="{Binding RefreshUpdatesCommand}"
                          IsEnabled="{Binding AreUpdatesActionsEnabled}"
                          Style="{StaticResource PrimaryButtonStyle}"/>
                  <Button Grid.Column="3"
                          Content="{Binding Strings.ApplyUpdates}"
                          MinWidth="{StaticResource DialogButtonMinWidth}"
                          Command="{Binding ApplyUpdatesCommand}"
                          IsEnabled="{Binding AreUpdatesActionsEnabled}"
                          Style="{StaticResource SuccessButtonStyle}"/>
                  <Button Grid.Column="5"
                          Content="{Binding Strings.CloseButton}"
                          MinWidth="{StaticResource ButtonMinWidth}"
                          Command="{Binding CloseUpdatesCommand}"
                          IsEnabled="{Binding AreUpdatesActionsEnabled}"
                          Style="{StaticResource NeutralButtonStyle}"/>
                </Grid>
              </Grid>

            </Grid>
          </Border>

          <!-- Log + status card -->
          <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <!-- Status strip -->
              <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <StackPanel Visibility="{Binding IsOperationProgressVisible, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="{Binding OperationProgressText}"/>
                    <ProgressBar Margin="0,4,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding OperationProgressValue}"/>
                  </StackPanel>

                  <Border Style="{StaticResource InlineStateBorderStyle}"
                          Visibility="{Binding IsWingetUpdateInProgress, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                      <TextBlock Style="{StaticResource SectionBodyTextStyle}"
                                 Text="{Binding Strings.WingetUpdatingText}"/>
                      <ProgressBar Margin="{StaticResource TopSpacing8}"
                                   IsIndeterminate="True"/>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="{Binding Strings.OpenLogFolder}"
                        Command="{Binding OpenLogFolderCommand}"
                        Style="{StaticResource NeutralButtonStyle}"
                        VerticalAlignment="Top"/>
              </Grid>

              <!-- Log -->
              <Grid Grid.Row="2">
                <TextBox x:Name="OutputLogBox"
                         Height="{x:Static sys:Double.NaN}"
                         Style="{StaticResource LogTextBoxStyle}"
                         Text="{Binding OutputText, Mode=OneWay}"
                         TextChanged="OnOutputLogTextChanged"
                         AutomationProperties.Name="{Binding Strings.OutputLogAutomationName}"/>

                <Border>
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource EmptyStateBorderStyle}">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding OutputText}" Value="">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <StackPanel>
                    <TextBlock HorizontalAlignment="Center"
                               Style="{StaticResource SectionTitleTextStyle}"
                               Text="{Binding Strings.LogTitle}"/>
                    <TextBlock Margin="{StaticResource TopSpacing6}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Style="{StaticResource SectionBodyTextStyle}"
                               Text="{Binding Strings.LogEmptyText}"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
